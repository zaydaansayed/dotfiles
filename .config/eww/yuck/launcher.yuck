;; =============================================================================
;; launcher.yuck
;; =============================================================================

(defwindow launcher
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "500px" :height "500px" :anchor "center")
  :stacking "fg"
  :focusable true
  (box :class "window"
       :orientation "v"
       :spacing 10
       :space-evenly false
     (box :orientation "h"
          :spacing 5
          :space-evenly false
       (box :space-evenly false
            :spacing 20
            :hexpand true
         (label :text ">"
                :class "launcher_searchicon")
          (input :hexpand true
                 :onchange "$HOME/dotfiles/.config/eww/scripts/launcher-query.sh '${replace(replace({}, "\\\\", "\\\\\\\\"), "'", "'\\''")}'")))
    (scroll :vscroll true
            :hscroll false
            :vexpand true
      (box :orientation "v"
           :spacing 4
           :space-evenly false
        (for app in launcher_list
          (box :orientation "h"
               :space-evenly false
               :spacing 5
               :visible {matches(app.name, "(?i)${launcher_query}")}
            (button :class "focusable launcher_app"
                    :hexpand true 
                    :onclick "$HOME/.config/eww/scripts/launcher.sh launch ${app.id}"
              (box :orientation "h"
                   :spacing 10
                   :space-evenly false
                (image :icon {app.icon}
                       :icon-size "dialog"
                       :valign "center"
                       :class "launcher_icon")
                  (label :text {app.name})))
            (button :onclick `~/.config/eww/scripts/pinned_apps.sh add ${app.id} && eww close launcher && eww update launcher_query="" 2>/dev/null || true && hyprctl dispatch 'hl.dsp.submap ("reset")'`
                    :class "focusable app_pin"
                    :tooltip "Pin to dock + main menu"
                    :visible {jq(apps.pinned, "any(.id == \"${app.id}\")") == false}
              "+")
            (button :onclick `$HOME/dotfiles/.config/eww/scripts/websearch.sh '${replace(replace(app.name, "\\\\", "\\\\\\\\"), "'", "'\\''")}'`
                    :class "focusable app_pin"
                    :tooltip "Search the web for this app"
              "⌕")))
      ;; Web search fallback — searches the browser for the raw query.
      (button :visible {launcher_query != ""}
              :class "focusable launcher_app launcher_web"
              :onclick `$HOME/dotfiles/.config/eww/scripts/websearch.sh '${replace(replace(launcher_query, "\\\\", "\\\\\\\\"), "'", "'\\''")}'`
              :tooltip "Open in browser"
        "⌕  Search web for '${launcher_query}'")
      ;; File results — proper file search under $HOME (2+ chars).
      (box :orientation "v"
           :spacing 6
           :space-evenly false
           :visible {launcher_query != ""}
        (label :text "Files"
               :halign "start"
               :class "launcher_section")
        (for f in files_json
          (button :class "focusable launcher_app"
                  :hexpand true
                  :onclick `xdg-open "${f.path}" && eww close launcher && eww update launcher_query="" && eww update files_json="[]" 2>/dev/null || true && hyprctl dispatch 'hl.dsp.submap ("reset")'`
                  :tooltip {f.path}
            (box :orientation "h"
                 :spacing 10
                 :space-evenly false
              (label :text "󰈙")
              (box :orientation "v"
                   :space-evenly false
                (label :text {f.name}
                       :limit-width 40)
                (label :text {f.path}
                       :limit-width 55
                       :class "launcher_filepath"))))))))))

