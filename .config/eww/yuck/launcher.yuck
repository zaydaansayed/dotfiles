;; =============================================================================
;; launcher.yuck
;; =============================================================================

(defwindow launcher
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "480px" :height "500px" :anchor "center")
  :stacking "fg"
  :focusable true
  (box :class "window launcher"
       :orientation "v"
       :spacing 10
       :space-evenly false
    (box :orientation "h"
         :spacing 20
         :space-evenly false
      (label :text ">" 
             :class "launcher_searchicon")
      (input :value launcher_dinput
             :hexpand true
             :onchange "eww update launcher_query='${replace(replace({}, "\\\\", "\\\\\\\\"), "'", "'\\''")}'"))
    (scroll :vscroll true
            :hscroll false
            :vexpand true
      (box :orientation "v"
           :spacing 4
           :space-evenly false
        (for app in launcher_list
          (button :class "launcher_app"
                  :tooltip {app.exec}
                  :visible {matches(app.name, "(?i)${launcher_query}")}
                  :onclick `~/.config/eww/scripts/launcher.sh launch ${app.id} &`
            (box :orientation "h"
                 :spacing 10
                 :space-evenly false
              (image :icon {app.icon}
                     :icon-size "dialog"
                     :valign "center"
                     :class "launcher_icon")
                 (label :text {app.name}))))))))

