;; =============================================================================
;; player.yuck
;; =============================================================================

; Music player window 
(defwindow music_player_window
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "210px" :height "110px" :anchor "top left")
  :stacking "fg" 
    (box :orientation "v"
         :space-evenly false
         :spacing 5
         :class "window"
      (music_info)
      (music_buttons)
      (button :onclick "eww close music_player_window && eww update music_toggle=false"
              :tooltip "Close"
        "")))

; Music info
(defwidget music_info []
  (box :orientation "h" 
       :space-evenly false
       :vexpand true
      (progress :orientation "v" :value {cava[0]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[1]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[2]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[3]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[4]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[5]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[6]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[7]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[8]} :class "cava_bar" :flipped true)
      (progress :orientation "v" :value {cava[9]} :class "cava_bar" :flipped true)
      (label :text "${player_data.text != '' && player_data.text != 'null' ? player_data.text : 'nothing playing'}"
             :wrap true 
             :show-truncated false
             :class "music_text")))

; Music buttons
(defwidget music_buttons []
  (box :orientation "h" 
       :space-evenly false
       :spacing 5
       :halign "center" 
       :class "music_buttons"
    (button :onclick "playerctl shuffle toggle"
            :class "shuffle_button"
            :tooltip "Shuffle"
      {player_data.shuffle_icon})
    (button :onclick "playerctl previous"
            :tooltip "Previous"
      "󰒮")
    (button :onclick "playerctl play-pause"
            :tooltip "Play/Pause"
      "${player_data.icon}")
    (button :onclick "playerctl next"
            :tooltip "Next"
      "󰒭")
    (button :onclick "bash -c 'current=$(playerctl loop); if [ \"$current\" = \"None\" ]; then playerctl loop Playlist; elif [ \"$current\" = \"Playlist\" ]; then playerctl loop Track; else playerctl loop None; fi'"
            :class "repeat_button"
            :tooltip "Repeat"
      "${player_data.repeat_icon}")))

; Most other files are in the variables.yuck file

; For more info go to https://github.com/zaydaansayed/dotfiles/blob/main/SUPPORT.md

