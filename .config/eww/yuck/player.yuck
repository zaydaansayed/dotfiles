(defwindow music_player_window
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "210px" :height "110px" :anchor "top left")
  :stacking "fg" 
    (box :orientation "v"
         :space-evenly false
         :spacing 5
         :class "window"
      (music_info)
      (music_buttons)
      (button :onclick "eww close music_player_window && eww update music_toggle=false"
              :tooltip "Close"
        "")))

(defwidget music_info []
  (box :orientation "h" 
       :space-evenly false
      (progress :orientation "v" :value {cava[0]} :flipped true)
      (progress :orientation "v" :value {cava[1]} :flipped true)
      (progress :orientation "v" :value {cava[2]} :flipped true)
      (progress :orientation "v" :value {cava[3]} :flipped true)
      (progress :orientation "v" :value {cava[4]} :flipped true)
      (progress :orientation "v" :value {cava[5]} :flipped true)
      (progress :orientation "v" :value {cava[6]} :flipped true)
      (progress :orientation "v" :value {cava[7]} :flipped true)
      (progress :orientation "v" :value {cava[8]} :flipped true)
      (progress :orientation "v" :value {cava[9]} :flipped true)
      (label :text "${player_data.text != '' && player_data.text != 'null' ? player_data.text : 'nothing playing'}"
             :class "music_text")))

(defwidget music_buttons []
  (box :orientation "h" 
       :space-evenly false
       :spacing 5
       :halign "center" 
       :class "music_buttons"
    (button :onclick "playerctl shuffle toggle"
            :class "shuffle_button"
            :tooltip "Shuffle"
      {player_data.shuffle_icon})
    (button :onclick "playerctl previous"
            :tooltip "Previous"
      "󰒮")
    (button :onclick "playerctl play-pause"
            :tooltip "Play/Pause"
      "${player_data.icon}")
    (button :onclick "playerctl next"
            :tooltip "Next"
      "󰒭")
    (button :onclick "bash -c 'current=$(playerctl loop); if [ \"$current\" = \"None\" ]; then playerctl loop Playlist; elif [ \"$current\" = \"Playlist\" ]; then playerctl loop Track; else playerctl loop None; fi'"
            :class "repeat_button"
            :tooltip "Repeat"
      "${player_data.repeat_icon}")))
