;; =============================================================================
;; LISTENERS
;; =============================================================================
(deflisten batinfo                :initial ""          "~/.config/eww/scripts/batinfo.sh")
(deflisten netinfo                :initial ""          "~/.config/eww/scripts/netinfo.sh")
(deflisten btinfo                 :initial ""          "~/.config/eww/scripts/btinfo.sh")
(deflisten active_workspace       :initial ""          "~/.config/eww/scripts/workspaces.sh")
(deflisten player_data            :initial ""          "~/.config/eww/scripts/player_data.sh")
(deflisten volinfo                :initial ""          "~/.config/eww/scripts/volinfo.sh")
(deflisten briginfo               :initial ""          "~/.config/eww/scripts/briginfo.sh")
(deflisten notif_visibility       :initial ""          "~/.config/eww/scripts/notif_visibility.sh")
(deflisten notif_history          :initial ""          "~/.config/eww/scripts/notif_history.sh")
(deflisten airplane_mode          :initial ""          "~/.config/eww/scripts/airplane_mode.sh")
(deflisten cava                   :initial ""          "~/.config/eww/scripts/cava.sh")
(deflisten active_apps            :initial ""          "~/.config/eww/scripts/active_apps.sh")
(deflisten pinned_apps            :initial ""          "~/.config/eww/scripts/pinned_apps.sh")
(deflisten cpu_usage              :initial ""          "~/.config/eww/scripts/cpu.sh")

;; =============================================================================
;; POLLERS
;; =============================================================================
(defpoll timenum           :interval "5s" "date +'%R'")
(defpoll tlpicon           :interval "1s"  "~/.config/eww/scripts/tlpicon.sh")
(defpoll date              :interval "30s" "echo \"$(date +'%a') $(date +'%d' | sed 's/^0//')th $(date +'%b')\" | tr 'A-Z' 'a-z'")
(defpoll username          :interval "24h" "echo $USER")
(defpoll weather_current   :interval "1h" "weather-Cli get -r")
(defpoll weather_future    :interval "1h" "~/dotfiles/.config/eww/scripts/weather_future.sh")

;; =============================================================================
;; VARIABLES
;; =============================================================================
(defvar notif_app                "")
(defvar notif_title              "")
(defvar notif_body               "")
(defvar tlp_toggle               "false")
(defvar quick_toggle             "false")
(defvar music_toggle             "false")
(defvar sysnotif_type            "information")
(defvar sysnotif_text_main       "")
(defvar sysnotif_text_butr       "")
(defvar sysnotif_text_butl       "")
(defvar sysnotif_commandbr       "eww close system_notification")
(defvar sysnotif_commandbl       "eww close system_notification")
(defvar sysnotif_commandi-a      "eww close system_notification")
(defvar sysnotif_text_input      "")
(defvar dock_visibility          "false")
(defvar main_toggle              "false")
(defvar selected_app             "")
(defvar tray_toggle              "false")
(defvar ai_prompt                "")
(defvar ai_toggle                "false")
(defvar ai_loading               "false")
(defvar ai_dinput                "")
(defvar ai_file_paths            "[]")
(defvar ai_image                 "false")
(defvar ai_chat_id               "")
(defvar ai_txt                   "[]")
(defvar ai_menu_toggle           "false")
(defvar ai_menu_chats            "[]")

