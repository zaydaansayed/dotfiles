;; =============================================================================
;; LISTENERS
;; =============================================================================
(deflisten batinfo :initial "󰁹 100%" "~/.config/eww/scripts/batinfo.sh")
(deflisten netinfo :initial '{"icon":"󰤭","netname":"offline","wifi_on":false,"net_on":false,"ethernet":false,"strength":0,"active":"","networks":[]}' "~/.config/eww/scripts/netinfo.sh")
(deflisten btinfo :initial '{"icon":"󰂲","devcname":"","bt_on":false,"scanning":false,"devices":[]}' "~/.config/eww/scripts/btinfo.sh")
(deflisten audio_state :initial '{"sink_vol":50,"source_vol":50,"sink_mute":false,"source_mute":false,"sinks":[],"sources":[],"cards":[]}' "~/.config/eww/scripts/audio_state.sh")
(deflisten active_workspace :initial "1" "~/.config/eww/scripts/workspaces.sh")
(deflisten obs_state :initial '{"running":false,"recording":false}' "~/.config/eww/scripts/obs_state.sh")
;; Widget visibility polls for the Settings > Widgets page.
(deflisten sysmon :initial '{"cpu":0,"mem":0,"disk":0}' "~/.config/eww/scripts/sysmon.sh")
(deflisten ws_extra :initial '[]' "~/.config/eww/scripts/workspaces_list.sh")
(deflisten player_data :initial '{"text":"","artist":"","title":"","icon":"","shuffle_icon":"","repeat_icon":"","image":"none","visible":"false"}' "~/.config/eww/scripts/player_data.sh")
(deflisten notif_visibility :initial "false" "~/.config/eww/scripts/notif_visibility.sh")
(deflisten notif_history :initial "[]" "~/.config/eww/scripts/notif_history.sh")
(deflisten airplane_mode :initial "󰀞" "~/.config/eww/scripts/airplane_mode.sh")
(deflisten apps :initial '{"pinned":[],"active":[],"is_first":"","is_last":"","focused":"","dock_clear":true}' "~/.config/eww/scripts/apps.sh")
(deflisten lyrics :initial '{"past":"","current":"","future":""}' "~/.config/eww/scripts/lyrics.py 2>/dev/null")
(deflisten dns :initial '{"con":"","servers":[],"auto":true,"preset":"auto"}' "~/.config/eww/scripts/dns.sh")
(deflisten clipboard_list :initial "[]" "~/.config/eww/scripts/clipboard.sh listen 50")
(deflisten stopwatch_state :initial '{"time":"00:00:00","status":"idle"}' "~/.config/eww/scripts/clock.sh stopwatch-listen")
(deflisten timer_state :initial '{"time":"00:05:00","status":"idle","total":300,"remaining":300,"progress":100}' "~/.config/eww/scripts/clock.sh timer-listen")
(deflisten emoji_list :initial '[]' "~/.config/eww/scripts/emoji.sh list")

;; =============================================================================
;; POLLERS
;; =============================================================================
(defpoll spinner :interval "100ms" "~/.config/eww/scripts/spinner.sh")
(defpoll timenum :interval "5s" "date +'%R'")
(defpoll timenums :interval "1s" "date +%T")
(defpoll tlpicon :interval "1s" "~/.config/eww/scripts/tlpicon.sh")
(defpoll date :interval "30s" "echo \"$(date +'%a') $(date +'%d' | sed 's/^0//')th $(date +'%b')\" | tr 'A-Z' 'a-z'")
(defpoll username :interval "24h" "echo $USER")
(defpoll current_theme :interval "24h" "cat ~/.config/eww/themes/current_theme.txt")
(defpoll weather_current :interval "1h" "weather-Cli get -r")
(defpoll weather_future :interval "1h" "~/.config/eww/scripts/weather_future.sh")
(defpoll launcher_list :initial "[]" :interval "24h" "~/.config/eww/scripts/launcher.sh")

;; =============================================================================
;; VARIABLES
;; =============================================================================
(defvar notifications_json "[]")
(defvar tlp_toggle false)
(defvar quick_toggle false)
(defvar music_toggle false)
(defvar sysnotif_type "information")
(defvar sysnotif_text_main "")
(defvar sysnotif_text_butr "")
(defvar sysnotif_text_butl "")
(defvar sysnotif_commandbr "eww close system_notification")
(defvar sysnotif_commandbl "eww close system_notification")
(defvar sysnotif_commandia "eww close system_notification")
(defvar sysnotif_text_input "")
(defvar dock_visibility false)
(defvar main_toggle false)
(defvar selected_app_id "")
(defvar selected_app_name "")
(defvar selected_app_desktop "")
(defvar selected_windows "[]")
(defvar tray_toggle false)
(defvar launcher_query "")
(defvar files_json "[]")
(defvar emoji_query "")
(defvar emoji_toggle false)
;; Spotlight side panel — filled in when picking › on an app row.
(defvar selected_launcher_id "")
(defvar selected_launcher_name "")
(defvar selected_launcher_exec "")
(defvar selected_launcher_icon "")
(defvar selected_launcher_desktop "")
(defvar clipboard_query "")
(defvar player_bg "rgba(9, 4, 9, 0.5)")
(defvar player_text "#ffffff")
(defvar connections_vis true)
(defvar audio_vis false)
(defvar ui_vis false)
(defvar as_vis false)
(defvar widget_vis false)
(defvar dock_busy false)
(defvar selected_app_icon "")
(defvar selected_app_pinned true)
(defvar clock_toggle false)
(defvar time_toggle true)
(defvar stopwatch_toggle false)
(defvar timer_toggle false)
(defvar timer_h 0)
(defvar timer_m 5)
(defvar timer_s 0)
(defvar widget_clock_open false)
(defvar widget_sys_open false)
(defvar widget_music_open false)
(defvar widget_calendar_open false)
(defvar setup_step 1)
;; Profile picture picker (launcher-style) — query, results, selection.
(defvar profile_picker_query "")
(defvar profile_images_json "[]")
(defvar selected_profile_path "")
(defvar selected_profile_name "")

