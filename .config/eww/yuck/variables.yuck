;; =============================================================================
;; LISTENERS
;; =============================================================================
(deflisten batinfo :initial "󰁹 100%" "~/.config/eww/scripts/batinfo.sh")
(deflisten netinfo :initial '{"icon":"󰤭","netname":"offline"}' "~/.config/eww/scripts/netinfo.sh")
(deflisten btinfo :initial '{"icon":"󰂲","devcname":""}' "~/.config/eww/scripts/btinfo.sh")
(deflisten active_workspace :initial "1" "~/.config/eww/scripts/workspaces.sh")
(deflisten player_data :initial '{"text":"","artist":"","title":"","icon":"","shuffle_icon":"","repeat_icon":"","image":"none","visible":"false"}' "~/.config/eww/scripts/player_data.sh")
(deflisten notif_visibility :initial "false" "~/.config/eww/scripts/notif_visibility.sh")
(deflisten notif_history :initial "[]" "~/.config/eww/scripts/notif_history.sh")
(deflisten airplane_mode :initial "󰀞" "~/.config/eww/scripts/airplane_mode.sh")
(deflisten active_apps :initial '{"apps":[],"workspace_windows":0}' "~/.config/eww/scripts/active_apps.sh")
(deflisten pinned_apps :initial '{"apps":[],"firefox_open":"false","firefox_focused":false,"spotify_open":false,"spotify_focused":false}' "~/.config/eww/scripts/pinned_apps.sh")
(deflisten lyrics :initial '{"past":"","current":"","future":""}' "~/.config/eww/scripts/lyrics.py")

;; =============================================================================
;; POLLERS
;; =============================================================================
(defpoll spinner :interval "100ms" "~/.config/eww/scripts/spinner.sh")
(defpoll timenum :interval "5s" "date +'%R'")
(defpoll tlpicon :interval "1s" "~/.config/eww/scripts/tlpicon.sh")
(defpoll date :interval "30s" "echo \"$(date +'%a') $(date +'%d' | sed 's/^0//')th $(date +'%b')\" | tr 'A-Z' 'a-z'")
(defpoll username :interval "24h" "echo $USER")
(defpoll current_theme :interval "24h" "cat ~/.config/eww/themes/current_theme.txt")
(defpoll weather_current :interval "1h" "weather-Cli get -r")
(defpoll weather_future :interval "1h" "~/.config/eww/scripts/weather_future.sh")
(defpoll launcher_list :initial "[]" :interval "30s" "~/.config/eww/scripts/launcher.sh")

;; =============================================================================
;; VARIABLES
;; =============================================================================
(defvar notifications_json "[]")
(defvar tlp_toggle "false")
(defvar quick_toggle "false")
(defvar music_toggle "false")
(defvar sysnotif_type "information")
(defvar sysnotif_text_main "")
(defvar sysnotif_text_butr "")
(defvar sysnotif_text_butl "")
(defvar sysnotif_commandbr "eww close system_notification")
(defvar sysnotif_commandbl "eww close system_notification")
(defvar sysnotif_commandia "eww close system_notification")
(defvar sysnotif_text_input "")
(defvar dock_visibility "false")
(defvar main_toggle "false")
(defvar selected_app "")
(defvar tray_toggle "false")
(defvar ai_prompt "")
(defvar ai_toggle "false")
(defvar ai_dinput "")
(defvar ai_file_paths "[]")
(defvar ai_image "false")
(defvar ai_chat_id "")
(defvar ai_txt "[]")
(defvar ai_menu_toggle "false")
(defvar ai_menu_chats "[]")
(defvar launcher_query "")
(defvar launcher_dinput "")
(defvar player_bg "rgba(9, 4, 9, 0.5)")
(defvar player_text "#ffffff")

