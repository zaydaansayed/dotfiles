(defwindow localsend
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "400px" :height "250px" :anchor "top center")
  :stacking "fg"
    (box :orientation "v"
         :space-evenly false
         :spacing 3
         :class "window"
      (box :orientation "h"
           :space-evenly false
           :halign "center"
           :spacing 3
        (button :class {localsend_tab == "receive" ? "lstab on" : "lstab"}
                :onclick "eww update localsend_tab=receive && pkill -f localsend-cli && /home/zaydaansayed/dotfiles/.config/eww/scripts/localsendr.sh &"
          "Receive")
        (button :class {localsend_tab == "send" ? "lstab on" : "lstab"}
                :onclick "eww update localsend_tab=send && pkill -f localsend-cli"
          "Send"))
      (receive)
      (send)
      (send_dialogue)
      (button :onclick "eww close localsend && eww update localsend_files='[]' && pkill -f localsend-cli"
              :valign "end"
              :vexpand true
              :tooltip "Close"
        "")))

(defwidget receive []
  (box :orientation "v" 
       :space-evenly false
       :visible {localsend_tab == "receive"}
       :hexpand true
       :vexpand true
       :halign "center"
       :valign "center"
         (label :text " "
                :class "placeholder_txt icon")
         (label :text "You can now receive files via Localsend"
                :class "placeholder_txt")))

(defwidget send []
  (box :orientation "h" 
       :space-evenly false
       :visible {localsend_tab == "send"}
    (box :orientation "v"
         :space-evenly false
      (label :text "Devices:"
             :valign "start"
             :halign "start")
      (label :text "Searching..."
             :visible {arraylength(localsend_devices) < 1})
      (for each in localsend_devices
        (button :onclick {arraylength(localsend_files) > 0 ? "eww update localsend_tab=send_dialogue && eww update ls_recipient=\"${each.icon} ${each.device}\" && localsend-cli send --to \"${each.device}\" $(echo '${localsend_files}' | jq -r '.[]') &" : "eww update sysnotif_type=information&& eww update sysnotif_text_main=\"Choose atleast 1 file\" && eww update sysnotif_text_butr=Ok && eww update sysnotif_text_butl=Cancel && eww update sysnotif_commandbr=\"eww close system_notification\" && eww update sysnotif_commandbl=\"eww close system_notification\" && eww open system_notification"}
                :class "ls_device_button"
          {each.device})))
    (scroll :hscroll false
            :vscroll true
            :halign "end"
            :hexpand true
            :class "l2 localsend_files"
      (box :orientation "v"
           :space-evenly false
           :spacing 3
        (button :onclick "/home/zaydaansayed/dotfiles/.config/eww/scripts/localsend_file_picker.sh &"
                :class "quick_button"
          "󰁦")
        (box :orientation "v"
             :space-evenly false
             :halign "center"
             :spacing 4
             :style  {arraylength(localsend_files) > 0 ? "border-bottom: 1px solid #7a7a7a;" : ""}
          (label :text "${arraylength(localsend_files)} File(s) Attached")
          (button :onclick "eww update localsend_files='[]'"
                  :tooltip "Clear All Attachments"
                  :class "localsend_clear_files"
                  :visible {arraylength(localsend_files) > 0}
            "Clear"))
        (for path in localsend_files
          (box :orientation "v"
               :space-evenly false
               :vexpand false
               :spacing 5
            (box :class "image localsend"
                 :visible {path != "" && matches(path ?: "", "(?i)\\.(png|jpg|jpeg|webp)$")}
                 :style "background-image: url('${path}');")
            (label :text path 
                   :show-truncated true
                   :visible {path != "" && !matches(path, "(?i)\\.(png|jpg|jpeg|webp)$")})))))))

(defwidget send_dialogue []
  (box :orientation "v"
       :visible {localsend_tab == "send_dialogue"}
    (label :text "  Linux"
           :class "ls_receive_txt")
    (label :text ""
           :class "ls_receive_txt")
    (label :text ls_recipient
           :class "ls_receive_txt")
    (button :onclick "eww update localsend_tab=send && pkill -f localsend-cli"
            :valign "end"
            :vexpand true
            :tooltip "Go back"
      "")))
