;; =============================================================================
;; ai.yuck
;; =============================================================================

; AI window
(defwindow ai
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "300px" :height "500px" :anchor "top right")
  :stacking "fg"
  :focusable "ondemand"
  (box :orientation "v"
       :space-evenly false
       :class "window"
    (ai_placeholder)
    (ai_chat)
    (ai_bottom)
    (box :orientation "h"
         :space-evenly false
         :spacing 3
      (button :onclick { ai_menu_toggle ? "eww close ai_menu && eww update ai_menu_toggle=false" : "eww update ai_menu_chats=\"$(cat $HOME/Documents/ai_chats/index.json 2>/dev/null || echo '[]')\" && eww open ai_menu && eww update ai_menu_toggle=true" }                       
              :class {ai_menu_toggle ? "ai_menu_button on" : "ai_menu_button"}
              :tooltip "Open Menu"
        "")
    (button :onclick "${EWW_CONFIG_DIR}/scripts/ai_menu_close.sh && ${EWW_CONFIG_DIR}/scripts/aipopup_close.sh && eww update ai_toggle=false && killall ollama && eww close ai"
            :class "ai_close"
            :tooltip "Close"
      ""))))

; Text when no chat is selected
(defwidget ai_placeholder []
  (box :orientation "v"
       :space-evenly false
       :class "ai_main"
       :visible {arraylength(ai_txt) < 1}
    (box :orientation "v"
         :space-evenly false
         :spacing 20
         :valign "center"
         :vexpand true
      (label :text "󰚩"
             :class "placeholder_txt ai icon")
      (label :text "Isaac is Ready!"
             :class "placeholder_txt message"))))

; Text when chat is selected
(defwidget ai_chat []
  (scroll :vscroll true
          :class "ai_main"
          :visible {arraylength(ai_txt) > 0}
    (box :orientation "v"
         :space-evenly false
      (for ai in ai_txt
        (box :orientation "v"
             :space-evenly false
          (for att in {ai.attachments ?: []}
            (box :orientation "v"
                 :space-evenly false
              (button :class "image ai_prompt"
                      :onclick "imv ${att} &"
                      :visible {att != "" && matches(att ?: "", "(?i)\\.(png|jpg|jpeg|webp)$")}
                      :style "background-image: url('${att}');"
                      :halign "end")
                (box :orientation "v"
                     :space-evenly false
                     :class "l2 ai_txt attachment"
                     :visible {att != "" && !matches(att, "(?i)\\.(png|jpg|jpeg|webp)$")}
                  (label :text "󰈙" :class "ai_txt document")
                  (label :text att
                         :limit-width 30))))
          (label :show-truncated false
                 :wrap true
                 :text {ai.prompt}
                 :halign "end"
                 :valign "start"
                 :class "l2 ai_txt prompt")
          (for block in {ai.response}
            (box :orientation "v"
                 :space-evenly false
              (label :show-truncated false
                     :wrap true
                     :text {block.content}
                     :halign "start"
                     :valign "start"
                     :class "l2 ai_txt"
                     :visible {block.type == "text"})
              (box :orientation "v"
                   :space-evenly false
                   :class "l2 ai_txt"
                   :visible {block.type == "code"}
                (box :orientation "h"
                     :space-evenly false
                  (label :text "Code" 
                         :halign "start" 
                         :hexpand true)
                  (button :onclick "echo \"${block.content}\" | wl-copy && $HOME/dotfiles/.config/eww/scripts/copy-popup.sh"
                          :class "ai_code_copy"
                          :tooltip "Copy Code"
                    "󰆏 Copy"))
                (input :value {block.content}
                       :class "ai_code_input")))))))))

(defwindow copy-popup
  :monitor 0
  :geometry (geometry :x "12px" :y "415px" :width "290px" :height "30px" :anchor "top right")
  :stacking "overlay"
  (label :text "󰆏 Text Copied!"
         :class "l3"))

(defwindow loading-popup
  :monitor 0
  :geometry (geometry :x "12px" :y "415px" :width "290px" :height "30px" :anchor "top right")
  :stacking "overlay"
  (label :text "Loading  ${spinner}"
         :class "l3"))

; Area around the ai prompt
(defwidget ai_bottom []
  (box :orientation "v"
       :class "ai_bottom"
       :space-evenly false
    (scroll :hscroll false
            :vscroll true
            :visible {arraylength(ai_file_paths) > 0}
            :class "l2 ai_iattached"
      (box :orientation "v"
           :space-evenly false
        (box :orientation "v"
             :space-evenly false
             :halign "center"
             :spacing 4
             :class "ai_att_top"
          (label :text "${arraylength(ai_file_paths)} File(s) Attached")
          (button :onclick "eww update ai_file_paths='[]'"
                  :tooltip "Clear All Attachments"
            "Clear"))
        (for path in ai_file_paths
          (box :orientation "v"
               :space-evenly false
               :spacing 5
               :class "ai_ifiles"
            (button :class "image ai_input"
                    :onclick "imv ${path} &"
                    :visible {path != "" && matches(path ?: "", "(?i)\\.(png|jpg|jpeg|webp)$")}
                    :style "background-image: url('${path}');")
            (label :text path 
                   :limit-width 10
                   :visible {path != "" && !matches(path, "(?i)\\.(png|jpg|jpeg|webp)$")})))))
    (box :orientation "h"
         :space-evenly false
(input :value ai_dinput
       :onchange "eww update ai_prompt=\"$(cat << 'EOF_SAFE'
{}
EOF_SAFE
)\""
       :onaccept {strlength(ai_prompt) > 0 ? "$HOME/dotfiles/.config/eww/scripts/ai.sh &" : ""}
       :class {strlength(ai_prompt) > 0 ? "ai_input" : "ai_input empty"})
      (button :onclick "$HOME/dotfiles/.config/eww/scripts/ai.sh &"
              :visible {strlength(ai_prompt) > 0}
              :class "ai_ibutton send"
              :tooltip "Send"
        "")
      (button :class "ai_ibutton"
              :onclick "$HOME/dotfiles/.config/eww/scripts/ai_file_picker.sh &"
              :tooltip "Attach file"
        "󰁦"))))

; Menu for choosing chats and configuring the ai
(defwindow ai_menu
  :monitor 0
  :geometry (geometry :x "310px" :y "3px" :width "200px" :height "510px" :anchor "top right")
  :stacking "fg"
  (box :orientation "v"
       :space-evenly false
       :class "window"
       :spacing 3
    (button :onclick "eww update ai_chat_id='' && eww update ai_txt='[]' && eww update ai_menu_toggle=false && eww close ai_menu"
            :class "ai_new_chat"
            :tooltip "Create New Chat"
            "+ New Chat")
    (scroll :vscroll true
            :hscroll false
            :vexpand true
            :class "ai_menu_scroll"
      (box :orientation "v"
           :space-evenly false
           :spacing 3
        (for chat in ai_menu_chats
  (box :orientation "h"
       :space-evenly false
       :spacing 3
    (button :onclick "eww update ai_chat_id='${chat.id}' && eww update ai_txt=\"$(cat $HOME/Documents/ai_chats/${chat.id}.json 2>/dev/null || echo '[]')\" && eww update ai_menu_toggle=false && eww close ai_menu"
            :tooltip {chat.title}
            :class {ai_chat_id == chat.id ? "ai_chat on" : "ai_chat"}
      (label :text {chat.title}
             :limit-width 20))
    (button :onclick "eww update sysnotif_type='input' && eww update sysnotif_text_input=${chat.title} && eww update sysnotif_text_main='Rename Chat' && eww update sysnotif_commandi-a='$HOME/dotfiles/.config/eww/scripts/ai_rename_chat.sh ${chat.id} \"{}\" & eww close system_notification' && eww open system_notification"
            :tooltip "Rename Chat"
      "󰏫")
   (button :onclick "~/.config/eww/scripts/ai_delete_chat.sh ${chat.id} &"
          :tooltip "Delete Chat"
     "󰆴")))))
    (button :onclick "eww update sysnotif_type='input' && eww update sysnotif_text_input=\"$(cat $HOME/Documents/ai_dynam_context.txt)\" && eww update sysnotif_text_main='Change AI Personality' && eww update sysnotif_commandi-a='echo '{}' > $HOME/Documents/ai_dynam_context.txt && eww close system_notification' && eww open system_notification"
            :tooltip "Change AI Personality"
      "")
    (button :onclick "eww update ai_menu_toggle=false && eww close ai_menu"
            :valign "end"
            :tooltip "Close"
      "")))

; Other files:
; file 1: (user-directory)/dotfiles/.config/eww/scripts/ai.sh
; file 2: (user-directory)/dotfiles/.config/scripts/Isaac-ai/ai.py
; Chats: (user-directory)/Documents/ai_chats
; Dynamic context: (user-directory)/Documents/ai_dynam_context.txt

; For more info go to https://github.com/zaydaansayed/dotfiles/blob/main/SUPPORT.md

