;; =============================================================================
;; settings.yuck — native control center (no rofi, no pavucontrol, no file editing)
;; Connections: nmcli / bluetoothctl lists wired natively in eww
;; Audio: pactl sliders + device switching
;; System: live hyprland controls (hyprctl + persisted to lua modules)
;; UI: live eww controls (themes, windows, player style, accent, opacity)
;; =============================================================================

(defwindow settings
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "920px" :height "600px" :anchor "center")
  :stacking "fg"
  (box :orientation "h"
       :space-evenly false
       :class "window settings_root"
       :spacing 10
    (box :orientation "v"
         :space-evenly false
         :spacing 5
         :class "settings_sidebar"
      (label :text "Settings"
             :halign "start"
             :class "settings_title")
      (button :class {connections_vis ? "settings_nav on" : "settings_nav"}
              :onclick {connections_vis ? "eww update connections_vis=false" : "eww update connections_vis=true audio_vis=false system_vis=false ui_vis=false"}
        "󱘖 Connections")
      (button :class {audio_vis ? "settings_nav on" : "settings_nav"}
              :onclick {audio_vis ? "eww update audio_vis=false" : "eww update connections_vis=false audio_vis=true system_vis=false ui_vis=false"}
        " Audio")
      (button :class {system_vis ? "settings_nav on" : "settings_nav"}
              :onclick {system_vis ? "eww update system_vis=false" : "eww update connections_vis=false audio_vis=false system_vis=true ui_vis=false"}
        " System")
      (button :class {ui_vis ? "settings_nav on" : "settings_nav"}
              :onclick {ui_vis ? "eww update ui_vis=false" : "eww update connections_vis=false audio_vis=false system_vis=false ui_vis=true"}
        " UI")
      (button :onclick "eww close settings"
              :class "settings_close"
              :valign "end"
              :vexpand true
        " Close"))
    (box :hexpand true
         :vexpand true
      (connections)
      (audio)
      (system)
      (UI))))

(defwidget connections []
  (box :orientation "v"
       :space-evenly false
       :vexpand true
       :visible connections_vis
    (label :text "Connections"
           :halign "start"
           :class "settings_heading")
    (scroll :vscroll true 
            :hscroll false 
            :vexpand true
            :height 510
      (box :orientation "v"
           :space-evenly false
           :spacing 10
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (box :orientation "h"
               :space-evenly false
               :spacing 10
            (label :text {netinfo.wifi_on ? "󰖩" : "󰖪"}
                   :class "settings_big_icon")
            (label :text "Wi-Fi"
                   :halign "start"
                   :vexpand true
                   :valign "center")
            (box :orientation "h"
                 :space-evenly false
                 :halign "end"
                 :spacing 5
                 :hexpand true
            (button :onclick "nmcli radio wifi ${netinfo.wifi_on ? "off" : "on"}"
                    :valign "center"
                    :class "long_btn"
              {netinfo.wifi_on ? "Disable" : "Enable"})
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/wifi_connect.sh --rescan"
                    :valign "center"
                    :class "long_btn reload"
                    :tooltip "Rescan networks"
              "󰑓")))
          (box :orientation "v"
               :space-evenly false
               :height 175
               :valign "center"
               :visible {netinfo.wifi_on && arraylength(netinfo.networks) == 0}
            (label :text "Scanning for networks  ${spinner}"
                   :halign "center"
                   :class "placeholder_txt"))
          (scroll :vscroll true
                  :hscroll false
                  :height 175
                  :visible {netinfo.wifi_on && arraylength(netinfo.networks) > 0}
            (box :orientation "v"
                 :space-evenly false
                 :hexpand true
                 :spacing 3
              (for net in {netinfo.networks}
              (box :orientation "h"
                   :space-evenly false
                   :hexpand true
                   :vexpand true
                   :class "l2 settings_list"
                   :spacing 20
                (label :text {net.signal > 75 ? "󰤨" : net.signal > 50 ? "󰤥" : net.signal > 25 ? "󰤢" : "󰤟"}
                       :valign "center"
                       :class "medium_icon")
                (box :orientation "v"
                     :space-evenly false
                     :hexpand true
                  (label :text {net.ssid}
                         :halign "start"
                         :limit-width 30)
                  (label :text {net.active ? "connected" : net.security == "" ? "open" : "secured"}
                         :halign "start"
                         :class "placeholder_txt"))
                (button :onclick "$HOME/dotfiles/.config/eww/scripts/wifi_connect.sh --prompt \"${net.ssid}\" &"
                        :visible {!net.active && net.security != ""}
                        :valign "center"
                        :class "long_btn"
                  "Connect")
                (button :onclick "$HOME/dotfiles/.config/eww/scripts/wifi_connect.sh \"${net.ssid}\" &"
                        :visible {!net.active && net.security == ""}
                        :valign "center"
                        :class "long_btn"
                  "Connect")
                (button :onclick "$HOME/dotfiles/.config/eww/scripts/wifi_connect.sh --disconnect \"${net.ssid}\" &"
                        :visible {net.active}
                        :valign "center"
                        :class "long_btn on"
                  "Disconnect"))))))
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (box :orientation "h"
               :space-evenly false
               :spacing 10
            (label :text {btinfo.bt_on ? "󰂱" : "󰂲"}
                   :class "settings_big_icon")
            (box :orientation "v"
                 :space-evenly false
                 :hexpand true
              (label :text "Bluetooth"
                     :halign "start")
              (label :text {btinfo.bt_on ? "${arraylength(btinfo.devices)} device(s) nearby" : "Off"}
                     :halign "start"
                     :class "placeholder_txt"))
            (box :orientation "h"
                 :space-evenly false
                 :spacing 5
              (button :onclick "rfkill unblock all && bluetoothctl power ${btinfo.bt_on ? "off" : "on"}"
                      :valign "center"
                      :class "long_btn"
                {btinfo.bt_on ? "Disable" : "Enable"}) 
              (button :onclick "$HOME/dotfiles/.config/eww/scripts/bt_scan.sh toggle &"
                      :visible {btinfo.bt_on}
                      :valign "center"
                      :tooltip "Toggle 25s scan"
                      :class "long_btn reload"
                {btinfo.scanning ? "Scanning  ${spinner}" : "󰑓"})))
          (box :orientation "v"
               :space-evenly false
               :vexpand true
               :visible {btinfo.bt_on && arraylength(btinfo.devices) == 0}
            (label :text "Scanning for devices ${spinner}"
                   :halign "center"
                   :class "placeholder_txt"))
          (scroll :vscroll true
                  :hscroll false
                  :height 135 
                  :visible {btinfo.bt_on && arraylength(btinfo.devices) > 0}
            (box :orientation "v"
                 :space-evenly false
                 :hexpand true
                 :spacing 3
              (for dev in {btinfo.devices}
              (box :orientation "h"
                   :space-evenly false
                   :vexpand true
                   :spacing 10
                   :class "l2 settings_list"
                (label :text {dev.connected ? "󰂱" : ""}
                       :valign "center"
                       :class "medium_icon")
                (box :orientation "v"
                     :space-evenly false
                     :valign "center"
                     :hexpand true
                  (label :text {dev.name}
                         :halign "start"
                         :limit-width 30)
                  (label :text {dev.connected ? "connected" : dev.nearby && dev.paired ? "paired · nearby" : dev.nearby ? "nearby — Connect to pair" : dev.paired ? "paired" : dev.mac}
                         :halign "start"
                         :class "placeholder_txt"))
                (box :orientation "h"
                     :space-evenly false
                     :spacing 5
                  (button :onclick "$HOME/dotfiles/.config/eww/scripts/bt_connect.sh ${dev.connected ? "--disconnect" : ""} \"${dev.mac}\" \"${dev.name}\" &"
                          :valign "center"
                          :class "long_btn"
                    {dev.connected ? "Disconnect" : "Connect"})
                  (button :onclick "bluetoothctl remove \"${dev.mac}\" &"
                          :visible {dev.paired}
                          :valign "center"
                          :class "long_btn"
                          :tooltip "Forget device"
                    "󰆴")))))))
        (box :orientation "h"
             :space-evenly false
             :spacing 10
             :class "l2 settings_card"
          (label :text {airplane_mode}
                 :class "settings_big_icon")
          (box :orientation "v"
               :space-evenly false
               :hexpand true
            (label :text "Airplane mode"
                   :halign "start")
            (label :text {airplane_mode == "󰀝" ? "On" : "Off"}
                   :halign "start"
                   :class "placeholder_txt"))
          (button :onclick {airplane_mode == "󰀝" ? "rfkill unblock all" : "rfkill block all"}
                  :valign "center"
                  :class "long_btn"
            {airplane_mode == "󰀝" ? "Disable" : "Enable"}))))))

(defwidget audio []
  (box :orientation "v"
       :space-evenly false
       :spacing 10
       :visible audio_vis
    (label :text "Audio"
           :halign "start"
           :class "settings_heading")
    (scroll :vscroll true 
            :hscroll false 
            :vexpand true 
            :height 450
      (box :orientation "v"
           :space-evenly false
           :spacing 10
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (box :orientation "h"
               :space-evenly false
               :spacing 10
            (label :text {audio_state.sink_mute ? "󰖁" : "󰕾"}
                   :class "settings_big_icon")
            (box :orientation "v"
                 :space-evenly false
                 :hexpand true
                 :spacing 10
              (label :text "Output — ${audio_state.sink_vol}%"
                     :halign "start")
              (scale :value {audio_state.sink_vol}
                     :class "settings_scale"
                     :min 0
                     :max 100
                     :hexpand true
                     :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")))
          (box :orientation "h"
               :space-evenly false
               :spacing 5
            (button :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
                    :hexpand true
                    :class "long_btn"
              {audio_state.sink_mute ? "󰕾 Unmute" : "󰖁 Mute"}))
          (label :text "Output device"
                 :halign "start"
                 :class "placeholder_txt")
          (label :text "Loading devices…  ${spinner}"
                 :halign "start"
                 :class "placeholder_txt"
                 :visible {arraylength(audio_state.sinks) == 0})
          (box :orientation "v"
               :space-evenly false
               :spacing 3
            (for sink in {audio_state.sinks}
              (button :onclick "pactl set-default-sink \"${sink.name}\""
                      :class {sink.def ? "long_btn on" : "long_btn"}
                "${sink.def ? "● " : "○ "}${sink.desc}"))))
        ;; Input card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (box :orientation "h"
               :space-evenly false
               :spacing 10
            (label :text {audio_state.source_mute ? "󰍭" : ""}
                   :class "settings_big_icon")
            (box :orientation "v"
                 :space-evenly false
                 :spacing 10
                 :hexpand true
              (label :text "Input — ${audio_state.source_vol}%"
                     :halign "start")
              (scale :value {audio_state.source_vol}
                     :min 0
                     :max 100
                     :hexpand true
                     :class "settings_scale"
                     :onchange "pactl set-source-volume @DEFAULT_SOURCE@ {}%")))
          (box :orientation "h"
               :space-evenly false
               :spacing 5
            (button :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
                    :hexpand true
                    :class "long_btn"
              {audio_state.source_mute ? " Unmute mic" : "󰍭 Mute mic"}))
          (label :text "Input device"
                 :halign "start"
                 :class "placeholder_txt")
          (label :text "Loading devices…  ${spinner}"
                 :halign "start"
                 :class "placeholder_txt"
                 :visible {arraylength(audio_state.sources) == 0})
          (box :orientation "v"
               :space-evenly false
               :spacing 3
            (for src in {audio_state.sources}
              (button :onclick "pactl set-default-source \"${src.name}\""
                      :class {src.def ? "long_btn on" : "long_btn"}
                "${src.def ? "● " : "○ "}${src.desc}"))))))))

;; ============================ SYSTEM (HYPR) =================================

(defwidget system []
  (box :orientation "v"
       :space-evenly false
       :spacing 10
       :visible system_vis
    (label :text "System — Hyprland (applies live, saved to modules)"
           :halign "start"
           :class "settings_heading")
    (scroll :vscroll true :hscroll false :vexpand true :height 450
      (box :orientation "v"
           :space-evenly false
           :spacing 10
        ;; Appearance card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text "󰖚 Appearance"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Gaps in" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.gaps_in ?: 5} :min 0 :max 20 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh gaps_in {}")
            (label :text "${hypr_state.gaps_in ?: 5}" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Gaps out" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.gaps_out ?: 7} :min 0 :max 20 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh gaps_out {}")
            (label :text "${hypr_state.gaps_out ?: 7}" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Border size" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.border_size ?: 2} :min 0 :max 5 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh border_size {}")
            (label :text "${hypr_state.border_size ?: 2}" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Rounding" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.rounding ?: 10} :min 0 :max 20 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh rounding {}")
            (label :text "${hypr_state.rounding ?: 10}" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Active opacity" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.active_op ?: 100} :min 50 :max 100 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh active_opacity {}")
            (label :text "${hypr_state.active_op ?: 100}%" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Inactive opacity" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.inactive_op ?: 100} :min 50 :max 100 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh inactive_opacity {}")
            (label :text "${hypr_state.inactive_op ?: 100}%" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh blur ${hypr_state.blur ? "false" : "true"}"
                    :hexpand true
                    :class {hypr_state.blur ? "on" : ""}
              "Blur")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh shadow ${hypr_state.shadow ? "false" : "true"}"
                    :hexpand true
                    :class {hypr_state.shadow ? "on" : ""}
              "Shadow")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh anims ${hypr_state.anims ? "false" : "true"}"
                    :hexpand true
                    :class {hypr_state.anims ? "on" : ""}
              "Animations"))
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh tearing ${hypr_state.tearing ? "false" : "true"}"
                    :hexpand true
                    :class {hypr_state.tearing ? "on" : ""}
              "Tearing"))
          (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh logo ${hypr_state.hide_logo ? "false" : "true"}"
                  :class {hypr_state.hide_logo ? "on" : ""}
            {hypr_state.hide_logo ? "Hide logo: on" : "Hide Hyprland logo"}))
        ;; Input card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text " Input"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Sensitivity" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.sens ?: 0} :min -100 :max 100 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh sensitivity {}")
            (label :text "${hypr_state.sens ?: 0}" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh nat_scroll ${hypr_state.nat_scroll ? "false" : "true"}"
                    :hexpand true
                    :class {hypr_state.nat_scroll ? "on" : ""}
              "Natural scroll")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh tap_click ${hypr_state.tap_click ? "false" : "true"}"
                    :hexpand true
                    :class {hypr_state.tap_click ? "on" : ""}
              "Tap to click")))
        ;; Display card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text "󰍹 Display — ${hypr_state.monitor ?: ""}"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Brightness" :valign "center" :width 160 :halign "start")
            (scale :value {briginfo.brightness}
                   :min 1 :max 100 :hexpand true
                   :onchange "brightnessctl set {}%")
            (label :text "${briginfo.brightness}%" :valign "center" :width 50))
          (label :text "Scale — current ${hypr_state.scale ?: 1}"
                 :halign "start"
                 :class "placeholder_txt")
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh scale 1.00 \"${hypr_state.monitor ?: "eDP-1"}\""
                    :hexpand true "1.00")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh scale 1.25 \"${hypr_state.monitor ?: "eDP-1"}\""
                    :hexpand true "1.25")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh scale 1.33 \"${hypr_state.monitor ?: "eDP-1"}\""
                    :hexpand true "1.33")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh scale 1.50 \"${hypr_state.monitor ?: "eDP-1"}\""
                    :hexpand true "1.50")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh scale 2.00 \"${hypr_state.monitor ?: "eDP-1"}\""
                    :hexpand true "2.00")))
        ;; Cursor + GTK card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text "󰆿 Cursor & toolkits"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Cursor size" :valign "center" :width 160 :halign "start")
            (scale :value {hypr_state.cursor_size ?: 24} :min 16 :max 48 :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh cursor_size {}")
            (label :text "${hypr_state.cursor_size ?: 24}" :valign "center" :width 50))
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh gtk_theme Adwaita-dark"
                    :hexpand true
                    :class {hypr_state.gtk_theme == "Adwaita-dark" ? "on" : ""}
              "GTK dark")
            (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh gtk_theme Adwaita"
                    :hexpand true
                    :class {hypr_state.gtk_theme == "Adwaita" ? "on" : ""}
              "GTK light")))
        ;; Startup card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text "󰈆 Startup programs"
                 :halign "start")
          (label :text "Takes effect on next login"
                 :halign "start"
                 :class "placeholder_txt")
          (label :text "Loading…  ${spinner}"
                 :halign "start"
                 :class "placeholder_txt"
                 :visible {arraylength(hypr_state.autostart) == 0})
          (box :orientation "v"
               :space-evenly false
               :spacing 3
            (for entry in {hypr_state.autostart}
              (box :orientation "h"
                   :space-evenly false
                   :spacing 8
                (label :text {entry.enabled ? "●" : "○"}
                       :valign "center"
                       :class {entry.enabled ? "" : "placeholder_txt"})
                (label :text {entry.cmd}
                       :halign "start"
                       :hexpand true
                       :limit-width 40
                       :class {entry.enabled ? "" : "placeholder_txt"})
                (button :onclick "$HOME/dotfiles/.config/eww/scripts/hypr_set.sh autostart_toggle ${entry.line}"
                        :valign "center"
                  {entry.enabled ? "Disable" : "Enable"})))))))))

;; ============================== UI (EWW) ====================================

(defwidget UI []
  (box :orientation "v"
       :space-evenly false
       :spacing 10
       :visible ui_vis
    (label :text "UI — eww (live, no file editing)"
           :halign "start"
           :class "settings_heading")
    (scroll :vscroll true :hscroll false :vexpand true :height 450
      (box :orientation "v"
           :space-evenly false
           :spacing 10
        ;; Theme card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text " Theme"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "$HOME/.config/eww/themes/night_sky/application.sh"
                    :hexpand true
                    :class {current_theme == "night_sky" ? "on" : ""}
              "󰖔 Night Sky")
            (button :onclick "$HOME/.config/eww/themes/default_dark/application.sh"
                    :hexpand true
                    :class {current_theme == "default_dark" ? "on" : ""}
              " Default Dark")))
        ;; Windows card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text " Windows"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick {quick_toggle ? "eww update quick_toggle=false && eww close quick_settings" : "eww update quick_toggle=true && eww open quick_settings"}
                    :hexpand true
                    :class {quick_toggle ? "on" : ""}
              " Quick")
            (button :onclick {ai_toggle ? "${EWW_CONFIG_DIR}/scripts/aipopup_close.sh && eww update ai_toggle=false && killall ollama && eww close ai" : "eww update ai_toggle=true && eww open ai && ollama serve &"}
                    :hexpand true
                    :class {ai_toggle ? "on" : ""}
              "󰚩 AI")
            (button :onclick {music_toggle ? "eww update music_toggle=false && eww close music_player_window" : "eww update music_toggle=true && eww open music_player_window"}
                    :hexpand true
                    :class {music_toggle ? "on" : ""}
              " Player"))
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick {main_toggle ? "eww close main_menu && eww update main_toggle=false" : "eww update main_toggle=true && eww open main_menu"}
                    :hexpand true
                    :class {main_toggle ? "on" : ""}
              "Main menu")
            (button :onclick "eww open --toggle launcher && eww update launcher_query='' && eww update launcher_dinput=''"
                    :hexpand true
              "󰍜 Launcher")
            (button :onclick {tray_toggle ? "eww close systemtray && eww update tray_toggle=false" : "eww open systemtray && eww update tray_toggle=true"}
                    :hexpand true
                    :class {tray_toggle ? "on" : ""}
              "Tray"))
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "eww open --toggle bar"
                    :hexpand true
              " Bar")
            (button :onclick "eww open --toggle dock"
                    :hexpand true
              "󱂩 Dock")
            (button :onclick "eww reload"
                    :hexpand true
                    :tooltip "Reload eww config"
              "󰑓 Reload")))
        ;; Player style card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text " Player style"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 5
            (button :onclick "eww update player_bg='rgba(9, 4, 9, 0.5)' player_text='#ffffff'"
                    :hexpand true "Dark")
            (button :onclick "eww update player_bg='rgba(0, 0, 0, 0.7)' player_text='#ffffff'"
                    :hexpand true "Black")
            (button :onclick "eww update player_bg='rgba(233, 154, 255, 0.25)' player_text='#ffffff'"
                    :hexpand true "Tinted")))
        ;; Accent card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text "󰏘 Accent color (patches theme, reloads eww)"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 5
            (button :class {eww_theme.accent == "#E99AFF" ? "swatch on" : "swatch"} :style "background-color: #E99AFF;" :tooltip "Pink (default)" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent E99AFF" " ")
            (button :class {eww_theme.accent == "#7AA2F7" ? "swatch on" : "swatch"} :style "background-color: #7AA2F7;" :tooltip "Blue" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent 7AA2F7" " ")
            (button :class {eww_theme.accent == "#9ECE6A" ? "swatch on" : "swatch"} :style "background-color: #9ECE6A;" :tooltip "Green" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent 9ECE6A" " ")
            (button :class {eww_theme.accent == "#E07D68" ? "swatch on" : "swatch"} :style "background-color: #E07D68;" :tooltip "Orange" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent E07D68" " ")
            (button :class {eww_theme.accent == "#A358D1" ? "swatch on" : "swatch"} :style "background-color: #A358D1;" :tooltip "Purple" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent A358D1" " ")
            (button :class {eww_theme.accent == "#549D9D" ? "swatch on" : "swatch"} :style "background-color: #549D9D;" :tooltip "Teal" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent 549D9D" " ")
            (button :class {eww_theme.accent == "#F7768E" ? "swatch on" : "swatch"} :style "background-color: #F7768E;" :tooltip "Red" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent F7768E" " ")
            (button :class {eww_theme.accent == "#FFFFFF" ? "swatch on" : "swatch"} :style "background-color: #FFFFFF;" :tooltip "White" :onclick "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh accent FFFFFF" " ")))
        ;; Background opacity card
        (box :orientation "v"
             :space-evenly false
             :spacing 8
             :class "l2 settings_card"
          (label :text "Background transparency"
                 :halign "start")
          (box :orientation "h" :space-evenly false :spacing 10
            (label :text "Opacity" :valign "center" :width 160 :halign "start")
            (scale :value {eww_theme.bg_alpha ?: 50} 
                   :min 20 
                   :max 100 
                   :hexpand true
                   :onchange "$HOME/dotfiles/.config/eww/scripts/eww_theme_set.sh bg {}")
            (label :text "${eww_theme.bg_alpha ?: 50}%" :valign "center" :width 50)))))))
