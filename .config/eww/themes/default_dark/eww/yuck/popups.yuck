;; =============================================================================
;; popups.yuck
;; =============================================================================

; Variables for this file
(deflisten volinfo :initial '{"icon":" ","volume":50}' "~/.config/eww/themes/default_dark/eww/scripts/volinfo.sh")
(deflisten briginfo :initial '{"icon":"󰃠 ","brightness":50}' "~/.config/eww/themes/default_dark/eww/scripts/briginfo.sh")
(deflisten mic_mute :initial '' "~/.config/eww/themes/default_dark/eww/scripts/mic_mute.sh")

; Volume popup window
(defwindow volume
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "192px" :height "18px" :anchor "top center")
  :stacking "fg" 
    (box :orientation "h"
         :space-evenly false
         :class "popup"
      (progress :orientation "h" 
                :value {volinfo.volume}
               :class "volbar")
        (label :text {volinfo.icon}
               :halign "center"
               :hexpand true)))

; Brightness popup window
(defwindow brightness
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "192px" :height "18px" :anchor "top center")
  :stacking "fg"
    (box :orientation "h"
         :space-evenly false
         :class "popup"
      (progress :orientation "h" 
                :value {briginfo.brightness}
                :class "brigbar")
        (label :text {briginfo.icon}
               :halign "center"
               :hexpand true)))

; Mic status popup
(defwindow mic_status
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "30px" :height "30px" :anchor "top center")
  :stacking "fg"
  (label :text mic_mute
         :class "popup"))

; Notification popup window
(defwindow notification_popup
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "300px" :anchor "top right")
  :stacking "fg"
  (box :orientation "v"
       :space-evenly false
       :spacing 10
    (for notif in notifications_json
      (button :onclick "~/.config/eww/scripts/dismiss_notif.sh ${notif.id} && makoctl dismiss"
              :class "window"
        (box :orientation "v"
             :space-evenly false 
          (label :text "${notif.app}"
                 :halign "start")
          (label :show-truncated false
                 :wrap true
                 :text "${notif.title}"
                 :halign "start")
          (label :show-truncated false
                 :wrap true
                 :text "${notif.body}"
                 :xalign 0))))))

; Most other files are found in the variables.yuck file, but the processes that calls the windows are in the hyprland.lua file

; For more info go to https://github.com/zaydaansayed/dotfiles/blob/main/SUPPORT.md

