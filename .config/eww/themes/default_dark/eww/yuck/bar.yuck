;; =============================================================================
;; bar.yuck
;; =============================================================================

; Bar window
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "99.7%" :height "30px" :anchor "top center")
  :stacking "fg"
  :exclusive true 
  (centerbox :orientation "h"
             :class "window"
    (box :space-evenly false
         :spacing 5
         (player) (workspaces))
    (box :space-evenly false 
         :tooltip date
         :spacing 6
         :class "bar_module"
      (button :onclick {clock_toggle ? "eww close clock && eww update clock_toggle=false" : "eww open --no-daemonize clock && eww update clock_toggle=true"}
              :class {clock_toggle ? "transparent_btn on" : "transparent_btn"}
        timenum)
      (button :onclick {clock_toggle ? "eww close clock && eww update clock_toggle=false" : "eww open --no-daemonize clock && eww update clock_toggle=true stopwatch_toggle=true time_toggle=false timer_toggle=false"}
              :visible {stopwatch_state.status != "idle"}
              :tooltip "Stopwatch: ${stopwatch_state.status} (${stopwatch_state.time}) — click to open"
              :class {stopwatch_state.status == "running" ? "sw_chip running" : "sw_chip paused"}
        (box :orientation "h" :spacing 12 :space-evenly false
          (label :text "")
          (label :text {stopwatch_state.time})
          (label :text {stopwatch_state.status == "running" ? "●" : "❚❚"}
                 :class {stopwatch_state.status == "running" ? "chip_dot running" : "chip_dot paused"})))
      ;; timer status chip
      (button :onclick {clock_toggle ? "eww close clock && eww update clock_toggle=false" : "eww open --no-daemonize clock & eww update clock_toggle=true timer_toggle=true time_toggle=false stopwatch_toggle=false"}
              :visible {timer_state.status != "idle"}
              :tooltip "Timer: ${timer_state.status} (${timer_state.time}) — click to open"
              :class {timer_state.status == "running" ? "tm_chip running" : timer_state.status == "paused" ? "tm_chip paused" : "tm_chip done"}
        (box :orientation "h" :spacing 12 :space-evenly false
          (label :text "󰁫")
          (label :text {timer_state.time})
          (label :text {timer_state.status == "running" ? "●" : timer_state.status == "paused" ? "❚❚" : " "}
                 :class {timer_state.status == "running" ? "chip_dot running" : timer_state.status == "paused" ? "chip_dot paused" : "chip_dot done"})))
      (button :visible {obs_state.running}
                   :onclick `hyprctl dispatch 'hl.dsp.focus({ window = "class:com.obsproject.Studio" })'`
                   :class {obs_state.recording ? "obsicon on" : "obsicon"}
                   :tooltip {obs_state.recording ? "OBS — recording ● (click to focus)" : "OBS running (click to focus)"}
            "󰻃"))
    (box :space-evenly false 
         :halign "end"
         :spacing 3
         (label  :text {btinfo.icon}
                 :visible {btinfo.icon == "󰂱"}
                 :class "bticon"
                 :tooltip {btinfo.devcname})
         (label  :text {netinfo.icon} 
                 :class "neticon"
                 :visible {airplane_mode == "󰀞"}
                 :tooltip {netinfo.netname})
         (label  :text {airplane_mode}
                 :visible {airplane_mode == "󰀝"}
                 :class "planeicon"
                 :tooltip "Airplane Mode on")
          (label  :text batinfo) 
          (button :onclick "$HOME/dotfiles/.config/eww/scripts/toggle.sh quick_settings quick_toggle"
                 :class {quick_toggle ? "quick_center on" : "quick_center"}
                 :tooltip "Open Quick Settings"
           "")
          (button :onclick "kitty -d $HOME -e opencode &"
                  :class "ai_center"
                  :tooltip "OpenCode (goated ai)"
            "󰚩"))))

; Workspaces widget
(defwidget workspaces []
  (box :orientation "h"
       :spacing 3
       :class "workspaces"
     (for i in "[1, 2, 3, 4, 5]"
       (button :onclick `hyprctl dispatch 'hl.dsp.focus({ workspace = ${i} })'`
               :class {active_workspace == i ? "on" : ""}
               :tooltip "Switch to workspace ${i}"
               (label :text i)))
     ;; Dynamic buttons for workspaces above 5 (no background-image — add your own).
     (for i in ws_extra
       (button :onclick `hyprctl dispatch 'hl.dsp.focus({ workspace = ${i} })'`
               :class {active_workspace == "${i}" ? "on" : ""}
               :tooltip "Switch to workspace ${i}"
               (label :text i)))))

; Player widget
(defwidget player []
  (box :class "player" 
       :orientation "h" 
       :space-evenly false
       :spacing 3
       :visible {player_data.visible}
    (button :onclick "playerctl play-pause"
            :tooltip "Play/Pause"
      "${player_data.icon}")
    (button :onclick "$HOME/dotfiles/.config/eww/scripts/toggle.sh music_player_window music_toggle"
            :class {music_toggle ? "music_player_button on" : "music_player_button"}
      (label :text {player_data.text}
             :limit-width 100
             :tooltip {player_data.text}))))

; Screenprint window
(defwindow screenprint
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "127px" :height "25px" :anchor "top center")
  :stacking "fg"
  (box :orientation "h"
       :spacing 3
       :class "window_small"
        (button :onclick "hyprshot -m output -o $HOME/Pictures/Screenshots | eww close screenprint"
               :tooltip "Fullscreen"
               :class "quick_button" 
               "󰍹")
        (button :onclick "hyprshot -m window -o $HOME/Pictures/Screenshots | eww close screenprint"
               :class "quick_button" 
               :tooltip "Window"
               "󰖯")
        (button :onclick "hyprshot -m region -o $HOME/Pictures/Screenshots | eww close screenprint"
               :class "quick_button" 
               :tooltip "Region"
               "")
        (button :onclick "eww close screenprint || true"
               :class "quick_button"                
               :tooltip "Close"
               "")))

; Power menu
(defwindow power_menu
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "0px" :height "0px" :anchor "center")
  :stacking "fg"
  (box :orientation "h"
       :space-evenly false
       :spacing 3
       :class "window_small"
    (button :onclick "reboot"
            :class "quick_button"
            :tooltip "Reboot"
            "")
    (button :onclick "poweroff"
            :class "quick_button"
            :tooltip "Shut-down"
            "")
    (button :onclick "systemctl hibernate; eww close power_menu || true"
            :class "quick_button"
            :tooltip "Hibernate"
            "")
    (button :onclick "systemctl suspend; eww close power_menu || true"
            :class "quick_button"
            :tooltip "Sleep"
            "")
    (button :onclick "eww close power_menu || true"
            :class "quick_button"
            :tooltip "Close"
            "")))

; Most other files will be found in the variables.yuck file but all screenshots will be saved to:
; (user-directory)/Pictures/Screenshots

; For more info go to https://github.com/zaydaansayed/dotfiles/blob/main/SUPPORT.md

