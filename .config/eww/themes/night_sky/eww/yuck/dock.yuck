;; =============================================================================
;; dock.yuck
;; =============================================================================

; Dock window 
(defwindow dock
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "0px" :height "3px" :anchor "bottom center")
  :stacking "fg"
  (eventbox :onhover "eww update dock_visibility=true" 
            :onhoverlost "eww update dock_visibility=false"
    (revealer :transition "slideup"
              :class "dock_revealed"
              :reveal {dock_visibility || apps.dock_clear || dock_busy}
      (box :orientation "h"
           :space-evenly false
           :spacing 5
        (button :onclick "$HOME/dotfiles/.config/eww/scripts/toggle.sh main_menu main_toggle"
                :class {main_toggle ? "main_menu_button on" : "main_menu_button"}
                :tooltip "Main Menu"
          " /\\\
|==|
/||\\\\")
        (label :text "|
|
|"
               :class "main_btn_separator")
        (apps)
        (button :onclick "$HOME/.config/eww/scripts/toggle.sh systemtray tray_toggle"
                :class "tray_button"
                :valign "center"
                :tooltip "System tray"
            (label :text {tray_toggle ? "" : ""}))))))

(defwidget apps []
  (box :orientation "h"
       :space-evenly false
       :spacing 5
    (box
      (for app in {apps.pinned}
        (box :orientation "v"
             :space-evenly false
             :spacing 0
          (button :timeout "5s" :onclick {app.count > 1 ? "~/.config/eww/scripts/apps-preview.sh ${app.id} && eww open --no-daemonize app_multiple_instances" : "/home/zaydaansayed/dotfiles/.config/eww/scripts/pinned_apps.sh launch ${app.id} &"}
                  :onrightclick "eww update selected_app_id='${app.id}' selected_app_name='${app.name}' selected_app_icon=${app.icon} selected_app_desktop=${app.desktop} selected_app_pinned=true dock_busy=true && eww open --no-daemonize app_rightclick"
                  :class {app.focused ? "dock_button on" : app.active ? "dock_button background" : "dock_button"}
                  :tooltip {app.active ? app.tooltip : app.name}
            (image :icon {app.icon}
                   :icon-size "dialog")))))
    (label :text "|
|
|"
           :visible {arraylength(apps.active) > 0})
    (box
      (for app in {apps.active}
        (button :timeout "5s" :onclick {app.count > 1 ? "~/.config/eww/scripts/apps-preview.sh ${app.desktop} && eww open --no-daemonize app_multiple_instances" : "hyprctl dispatch \"hl.dsp.focus({ window = \\\"address:${app.focus_address}\\\" })\""}
                :onrightclick "eww update selected_app_id='${app.desktop}' selected_app_name='${app.name}' selected_app_icon=${app.icon} selected_app_desktop='${app.desktop}' selected_app_pinned=false dock_busy=true && eww open --no-daemonize app_rightclick"
                :class {app.focused ? "dock_button on" : "dock_button"}
                :tooltip {app.tooltip}
          (image :icon {app.icon}
                 :icon-size "dialog"))))))

(defwindow app_rightclick
  :monitor 0
  :geometry (geometry :x "0px" :y "70px" :width "0px" :height "0px" :anchor "bottom center")
  :stacking "fg"
  (eventbox :onhoverlost "eww close app_rightclick && eww update dock_busy=false" 
    (box :orientation "v"
         :space-evenly false
         :class "window"
         :spacing 10 
      (box :orientation "h"
           :space-evenly false
           :spacing 10
        (image :icon selected_app_icon
               :icon-size "dialog")
        (label :text selected_app_name))
      (box :orientation "v"
           :space-evenly false
           :spacing 10
           :visible {selected_app_pinned == "false"}
        (button :onclick "$HOME/.config/eww/scripts/pinned_apps.sh add ${selected_app_desktop} && eww close app_rightclick"
                :class "long_btn"
          "Pin app 󰤱")
        (button :onclick "$HOME/.config/eww/scripts/pinned_apps.sh close ${selected_app_id} && eww close app_rightclick"
                :class "long_btn"
          "End Task"))
      (box :orientation "v"
           :space-evenly false
           :spacing 10
           :visible selected_app_pinned
        (for p in {apps.pinned}
          (box :visible {p.id == selected_app_id}
               :orientation "v"
               :space-evenly false
               :spacing 10
            (button :onclick "$HOME/.config/eww/scripts/pinned_apps.sh open ${selected_app_id}"
                    :class "long_btn"
              "Open new window")
            (button :visible {p.active}
                    :onclick "$HOME/.config/eww/scripts/pinned_apps.sh close ${selected_app_id} && eww update dock_busy=false && eww close app_rightclick"
                    :class "long_btn"
              "End Task")))
        (button :onclick "$HOME/.config/eww/scripts/pinned_apps.sh move ${selected_app_id} -"
                :class "long_btn"
                :visible {selected_app_id != apps.is_first}
          " Move Left") 
        (button :onclick "$HOME/.config/eww/scripts/pinned_apps.sh move ${selected_app_id} +"
                :class "long_btn"
                :visible {selected_app_id != apps.is_last}
          "Move Right ")
        (button :onclick "$HOME/.config/eww/scripts/pinned_apps.sh rm ${selected_app_id} && eww update dock_busy=false && eww close app_rightclick"
                :class "long_btn"
          "Unpin 󰤰")))))

; Window with live previews when an app has multiple windows open
(defwindow app_multiple_instances
  :monitor 0
  :geometry (geometry :x "0px" :y "70px" :width "0px" :height "0px" :anchor "bottom center")
  :stacking "fg"
  (box :class "window"
    (eventbox :onhoverlost "eww close app_multiple_instances || true"
      (box :orientation "h"
           :space-evenly false
           :spacing 8
        (for win in {selected_windows}
          (button :onclick "~/.config/eww/scripts/pinned_apps.sh focus ${win.address} && eww close app_multiple_instances || true"
                  :class {win.focused ? "dock_button on" : "dock_button"}
                  :tooltip {win.title}
            (box :orientation "v"
                 :space-evenly false
                 :spacing 4
              (image :visible {win.shot}
                     :path {win.preview}
                     :image-width 200)
              (image :visible {!win.shot}
                     :icon {win.icon}
                     :icon-size "dialog")
              (label :text {win.title}
                     :limit-width 24
                     :wrap true))))))))

(defwindow systemtray
  :monitor 0
  :geometry (geometry :x "0px" :y "70px" :width "0px" :height "0px" :anchor "bottom center")
  :stacking "fg"
  (eventbox :onhoverlost "eww close systemtray || true; eww update tray_toggle=false"
    (systray :spacing 4
             :prepend-new true
             :class "window")))

