;; =============================================================================
;; bar.yuck
;; =============================================================================

; Bar window
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "99.7%" :height "30px" :anchor "top center")
  :stacking "fg"
  :exclusive true 
  (centerbox :orientation "h"
    (box :space-evenly false
         :halign "start"
         :spacing 5
         :class "bar_module start"
         (player) (workspaces))
    (box :space-evenly false 
         :tooltip date
         :class "bar_module time"
      (label :text timenum))
    (box :space-evenly false 
         :halign "end"
         :class "bar_module bar_end"
         :spacing 3
         (label  :text {btinfo.icon}
                 :visible {btinfo.icon == "󰂱"}
                 :class "bticon"
                 :tooltip {btinfo.devcname})
         (label  :text {netinfo.icon} 
                 :class "neticon"
                 :visible {airplane_mode == "󰀞"}
                 :tooltip {netinfo.netname})
         (label  :text {airplane_mode}
                 :visible {airplane_mode == "󰀝"}
                 :class "planeicon"
                 :tooltip "Airplane Mode on")
         (label  :text batinfo)
         (button :onclick {quick_toggle ? "eww update quick_toggle=false && eww close quick_settings" : "eww update quick_toggle=true && eww open quick_settings"}
                 :class {quick_toggle ? "quick_center on" : "quick_center"}
                 :tooltip "Open Quick Settings"
           "") 
         (button :onclick {ai_toggle ? "${EWW_CONFIG_DIR}/scripts/aipopup_close.sh && eww update ai_toggle=false && killall ollama && eww close ai" : "eww update ai_toggle=true && eww open ai && ollama serve &"}
                 :class {ai_toggle ? "ai_center on" : "ai_center"}
                 :tooltip "Open Isaac AI"
           "󰚩"))))

; Workspaces widget
(defwidget workspaces []
  (box :orientation "h"
       :spacing 3
    (button :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
            :class {active_workspace == "1" ? "workspace a ws_on" : "workspace a off"}
            :style "background-image: url('${EWW_CONFIG_DIR}/themes/night_sky/images/workspace1.png');"
            :tooltip "Switch to workspace 1"
      "1")
    (button :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
            :class {active_workspace == "2" ? "workspace a ws_on" : "workspace a off"}
            :style "background-image: url('${EWW_CONFIG_DIR}/themes/night_sky/images/workspace2.png');"
            :tooltip "Switch to workspace 2"
      "2")
    (button :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
            :class {active_workspace == "3" ? "workspace b ws_on" : "workspace b off"}
            :style "background-image: url('${EWW_CONFIG_DIR}/themes/night_sky/images/workspace3.png');"
            :tooltip "Switch to workspace 3"
      "3")
    (button :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
            :class {active_workspace == "4" ? "workspace b ws_on" : "workspace b off"}
            :style "background-image: url('${EWW_CONFIG_DIR}/themes/night_sky/images/workspace4.png');"
            :tooltip "Switch to workspace 4"
      "4")
    (button :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
            :class {active_workspace == "5" ? "workspace a ws_on" : "workspace a off"}
            :style "background-image: url('${EWW_CONFIG_DIR}/themes/night_sky/images/workspace5.png');"
            :tooltip "Switch to workspace 5"
              "5")))

; Player widget
(defwidget player []
  (box :class "player" 
       :orientation "h" 
       :space-evenly false
       :spacing 3
       :visible {player_data.visible}
    (button :onclick "playerctl play-pause"
            :tooltip "Play/Pause"
            :class "play-pause"
      "${player_data.icon}")
    (button :onclick {music_toggle ? "eww update music_toggle=false && eww close music_player_window" : "eww update music_toggle=true && eww open music_player_window"}
            :class {music_toggle ? "transparent_btn music on" : "transparent_btn music"}
      (label :text {player_data.text}
             :limit-width 100
             :tooltip {player_data.text}))))

; Screenprint window
(defwindow screenprint
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "127px" :height "25px" :anchor "top center")
  :stacking "fg"
  (box :orientation "h"
       :spacing 3
       :class "window_small"
       (button :onclick "hyprshot -m output -o $HOME/Pictures/Screenshots | eww close screenprint" 
               :tooltip "Fullscreen"
               :class "quick_button" 
               "󰍹")
       (button :onclick "hyprshot -m window -o $HOME/Pictures/Screenshots | eww close screenprint" 
               :class "quick_button" 
               :tooltip "Window"
               "󰖯")
       (button :onclick "hyprshot -m region -o $HOME/Pictures/Screenshots | eww close screenprint" 
               :class "quick_button" 
               :tooltip "Region"
               "")
       (button :onclick "eww close screenprint" 
               :class "quick_button"                
               :tooltip "Close"
               "")))

; Power menu
(defwindow power_menu
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "0px" :height "0px" :anchor "center")
  :stacking "fg"
  (box :orientation "h"
       :space-evenly false
       :spacing 3
       :class "window_small"
    (button :onclick "reboot"
            :class "quick_button"
            :tooltip "Reboot"
            "")
    (button :onclick "poweroff"
            :class "quick_button"
            :tooltip "Shut-down"
            "")
    (button :onclick "systemctl hibernate && eww close power_menu"
            :class "quick_button"
            :tooltip "Hibernate"
            "")
    (button :onclick "systemctl suspend && eww close power_menu"
            :class "quick_button"
            :tooltip "Sleep"
            "")
    (button :onclick "eww close power_menu"
            :class "quick_button"
            :tooltip "Close"
            "")))

; Most other files will be found in the variables.yuck file but all screenshots will be saved to:
; (user-directory)/Pictures/Screenshots

; For more info go to https://github.com/zaydaansayed/dotfiles/blob/main/SUPPORT.md

