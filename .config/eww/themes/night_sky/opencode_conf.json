{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#090409",
    "panel": "#151020",
    "element": "#1B1428",
    "fg": "#FFFFFF",
    "muted": "#777777",
    "violet": "#A358D1",
    "peach": "#E07D68",
    "pink": "#E99AFF",
    "teal": "#549D9D",
    "cream": "#FFB07C",
    "coral": "#C26B59"
  },
  "theme": {
    "primary": { "dark": "violet", "light": "violet" },
    "secondary": { "dark": "pink", "light": "pink" },
    "accent": { "dark": "teal", "light": "teal" },
    "error": { "dark": "coral", "light": "coral" },
    "warning": { "dark": "cream", "light": "cream" },
    "success": { "dark": "teal", "light": "teal" },
    "info": { "dark": "pink", "light": "pink" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "muted", "light": "muted" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "panel", "light": "fg" },
    "backgroundElement": { "dark": "element", "light": "element" },
    "border": { "dark": "muted", "light": "muted" },
    "borderActive": { "dark": "violet", "light": "violet" },
    "borderSubtle": { "dark": "muted", "light": "muted" },
    "diffAdded": { "dark": "teal", "light": "teal" },
    "diffRemoved": { "dark": "coral", "light": "coral" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "violet", "light": "violet" },
    "diffHighlightAdded": { "dark": "teal", "light": "teal" },
    "diffHighlightRemoved": { "dark": "coral", "light": "coral" },
    "diffAddedBg": { "dark": "element", "light": "element" },
    "diffRemovedBg": { "dark": "panel", "light": "panel" },
    "diffContextBg": { "dark": "panel", "light": "panel" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "element", "light": "element" },
    "diffRemovedLineNumberBg": { "dark": "panel", "light": "panel" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "peach", "light": "peach" },
    "markdownLink": { "dark": "pink", "light": "pink" },
    "markdownLinkText": { "dark": "teal", "light": "teal" },
    "markdownCode": { "dark": "teal", "light": "teal" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "cream", "light": "cream" },
    "markdownStrong": { "dark": "peach", "light": "peach" },
    "markdownHorizontalRule": { "dark": "muted", "light": "muted" },
    "markdownListItem": { "dark": "violet", "light": "violet" },
    "markdownListEnumeration": { "dark": "teal", "light": "teal" },
    "markdownImage": { "dark": "pink", "light": "pink" },
    "markdownImageText": { "dark": "teal", "light": "teal" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "violet", "light": "violet" },
    "syntaxFunction": { "dark": "peach", "light": "peach" },
    "syntaxVariable": { "dark": "teal", "light": "teal" },
    "syntaxString": { "dark": "teal", "light": "teal" },
    "syntaxNumber": { "dark": "cream", "light": "cream" },
    "syntaxType": { "dark": "pink", "light": "pink" },
    "syntaxOperator": { "dark": "violet", "light": "violet" },
