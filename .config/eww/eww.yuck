(deflisten batinfo                :initial ""          `~/.config/eww/scripts/batinfo.sh`)
(deflisten netinfo                :initial ""          `~/.config/eww/scripts/netinfo.sh`)
(deflisten btinfo                 :initial ""          `~/.config/eww/scripts/btinfo.sh`)
(deflisten active_workspace       :initial ""          `~/.config/eww/scripts/workspaces.sh`)
(deflisten player_data            :initial ""          `~/.config/eww/scripts/player_data.sh`)
(deflisten volinfo                :initial ""          `~/.config/eww/scripts/volinfo.sh`)
(deflisten briginfo               :initial ""          `~/.config/eww/scripts/briginfo.sh`)
(deflisten notif_visibility       :initial ""          `~/dotfiles/.config/eww/scripts/notif_visibility.sh`)
(deflisten notif_history          :initial ""          `~/dotfiles/.config/eww/scripts/notif_history.sh`)
(deflisten bluetooth_button       :initial ""          `~/.config/eww/scripts/bluetooth_button.sh`)
(deflisten bticon_button          :initial ""          `~/.config/eww/scripts/bticon_button.sh`)
(deflisten cava                   :initial ""          `~/dotfiles/.config/eww/scripts/cava.sh`)
(deflisten active_apps            :initial ""          `~/dotfiles/.config/eww/scripts/active_apps.sh`)

(defpoll timenum :interval "30s" `date +"%R"`)
(defpoll tlpicon :interval "1s"  `~/.config/eww/scripts/tlpicon.sh`)
(defpoll date    :interval "30s" `date "+%A, %B %d"`)
(defpoll ai_txt  :interval "1s" "cat /home/zaydaansayed/Documents/ai_chats/$(eww get ai_chat_id).json 2>/dev/null || echo '[]'")

(defpoll ai_menu_chats :interval "100ms" "cat /home/zaydaansayed/Documents/ai_chats/index.json 2>/dev/null || echo '[]'")

(defvar notif_app           "")
(defvar notif_title         "")
(defvar notif_body          "")
(defvar tlp_toggle          "false")
(defvar quick_toggle        "false")
(defvar music_toggle        "false")
(defvar localsend_tabR      "true")
(defvar localsend_tabS      "false")
(defvar sysnotif_type       "information")
(defvar sysnotif_text_main  "")
(defvar sysnotif_text_butr  "")
(defvar sysnotif_text_butl  "")
(defvar sysnotif_commandr   "")
(defvar sysnotif_commandl   "")
(defvar sysnotif_commandi-c "")
(defvar sysnotif_commandi-a "")
(defvar sysnotif_input_val  "")
(defvar dock_visibility     "false")
(defvar tray_toggle         "false")
(defvar ai_prompt           "")
(defvar ai_toggle           "false")
(defvar ai_loading          "false")
(defvar ai_dinput           "")
(defvar ai_file_paths       "[]")
(defvar ai_image            "false")
(defvar ai_chat_id          "")

(defwidget player []
  (box :class "player" 
       :orientation "h" 
       :space-evenly false
       :spacing 3
       :visible {player_data.visible}
    (button :onclick "playerctl play-pause"
            :tooltip "Play/Pause"
      "${player_data.icon}")
    (button :onclick {music_toggle == "true" ? "eww update music_toggle=false && eww close music_player" : "eww update music_toggle=true && eww open music_player"}
            :class {music_toggle == "true" ? "music_player_button on" : "music_player_button"}
      (label :text {player_data.text}))))

(defwidget workspaces []
  (box :orientation "h"
       :spacing 3
    (for i in "[1, 2, 3, 4, 5]"
      (button :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = ${i} })'"
              :class {active_workspace == i ? "on" : ""}
              :tooltip "Switch to workspace ${i}"
              (label :text i)))))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "1273px" :height "25px" :anchor "top center")
  :stacking "bg"
  :exclusive true 
  (centerbox :orientation "h"
    (box :space-evenly false
         :spacing 5
         (player) (workspaces))
    (box :space-evenly false 
         :tooltip date 
      (label :text timenum))
    (box :space-evenly false 
         :halign "end"
         :spacing 3
         (label  :text {btinfo.icon}  
                 :class "bticon"
                 :tooltip {btinfo.devcname})
         (label  :text {netinfo.icon} 
                 :class "neticon"
                 :tooltip {netinfo.netname})
         (label  :text batinfo)
         (button :onclick {quick_toggle == "true" ? "eww update quick_toggle=false && eww close quick_settings" : "eww update quick_toggle=true && eww open quick_settings"}
                 :class {quick_toggle == "true" ? "quick_center on" : "quick_center"}
                 :tooltip "Open Quick Settings"
           "")
         (button :onclick {ai_toggle ? "" : "eww update ai_chat_id='' && eww update ai_toggle=true && eww open ai && ollama serve &"}
        :class {ai_toggle ? "ai_center on" : "ai_center"}
        :tooltip "Open Isaac AI"
  "󰚩"))))

(defwindow screenprint
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "127px" :height "25px" :anchor "top center")
  :stacking "fg"
  (box :orientation "h"
       :spacing 3
       :class "window_small"
       (button :onclick "hyprshot -m output -o /home/zaydaansayed/Pictures/Screenshots | eww close screenprint" 
               :tooltip "Fullscreen"
               :class "quick_button" 
               "󰍹")
       (button :onclick "hyprshot -m window -o /home/zaydaansayed/Pictures/Screenshots | eww close screenprint" 
               :class "quick_button" 
               :tooltip "Window"
               "󰖯")
       (button :onclick "hyprshot -m region -o /home/zaydaansayed/Pictures/Screenshots | eww close screenprint" 
               :class "quick_button" 
               :tooltip "Region"
               "")
       (button :onclick "eww close screenprint" 
               :class "quick_button"                
               :tooltip "Close"
               "")))

(defwindow volume
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "192px" :height "18px" :anchor "top center")
  :stacking "fg" 
    (box :orientation "h"
         :space-evenly false
      (progress :orientation "h" 
                :value {volinfo.volume}
               :class "volbar")
        (label :text {volinfo.icon})))

(defwindow brightness
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "192px" :height "18px" :anchor "top center")
  :stacking "fg"
    (box :orientation "h"
         :space-evenly false
      (progress :orientation "h" 
                :value {briginfo.brightness}
                :class "brigbar")
        (label :text {briginfo.icon})))

(defwindow notification_popup
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "300px" :height "0px" :anchor "top right")
  :stacking "fg"
  (box :orientation "v"
       :space-evenly false
       :class "window"
    (box :orientation "h"
         :space-evenly false
      (label :text notif_app)
      (button :onclick "eww close notification_popup && makoctl dismiss"
               :halign "end"
               :hexpand true
         (label :text "")))
    (label :show-truncated false
           :wrap true
           :text notif_title
           :halign "start")
    (label :show-truncated false
           :wrap true
           :text notif_body
           :xalign 0)))

(defwindow quick_settings
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "0px" :height "0px" :anchor "top right")
  :stacking "fg"
    (box :orientation "v"
         :space-evenly false
         :class "window"
      (quickS_topbar)
      (quick_controls)
      (tlp_menu)
      (quick_sliders)
      (notification_history)))

(defwidget quickS_topbar []
  (box :orientation "h"
       :space-evenly false
    (button :onclick "eww close quick_settings && eww update quick_toggle=false"
            :class "quick_close"
            :tooltip "Close"
      "")
    (button :onclick "eww open power_menu && eww close quick_settings && eww update quick_toggle=false"
            :class "quick_power"
            :tooltip "Open Power Menu"
      "")))

(defwidget quick_controls []
  (box :orientation "v"
       :space-evenly false
    (box :orientation "h"
         :space-evenly false
         :class "quick_controls_top"
      (button :class {netinfo.icon == "󰤭" ? "quick_button net" : "quick_button net on"}
              :onclick "nmcli networking | grep -q 'enabled' && nmcli networking off || nmcli networking on"
              :tooltip {netinfo.netname}
              {netinfo.icon})
      (button :class {netinfo.icon == "󰤭" ? "quick_extend net" : "quick_extend net on"}
              :onclick "networkmanager_dmenu | eww close quick_settings | eww update quick_toggle=false"
              :tooltip {netinfo.netname}
              ">")
      (button :class {btinfo.button == "󰂲" ? "quick_button bt" : "quick_button bt on"}
              :onclick "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
              :tooltip {btinfo.devcname}
              {btinfo.button})
      (button :class {btinfo.button == "󰂲" ? "quick_extend bt" : "quick_extend bt on"}
              :onclick "bzmenu -l fuzzel | eww close quick_settings | eww update quick_toggle=false"
              :tooltip {btinfo.devcname}
             ">")
      (button :class {tlp_toggle == "true" ? "quick_button on" : "quick_button"}
              :onclick {tlp_toggle == "true" ? "eww update tlp_toggle=false" : "eww update tlp_toggle=true"}
              :tooltip "Power Profiles"
              tlpicon))
    (box :orientation "h"
         :space-evenly false
      (button :class "quick_button localsend_button"
              :onclick "eww open localsend && eww close quick_settings && eww update quick_toggle=false && /home/zaydaansayed/dotfiles/.config/eww/scripts/localsendr.sh &"
              :tooltip "Share files"
        ""))))

(defwidget tlp_menu []
  (box :orientation "h"
       :space-evenly false
       :class "tlp_menu"
       :visible tlp_toggle
       :spacing 5
   (button :class {tlpicon == "" ? "prfp_button on" : "prfp_button"}
           :onclick "tlpctl power-saver &"
           :tooltip "Low power mode"
           "")
   (button :class {tlpicon == "" ? "prfp_button on" : "prfp_button"}
           :onclick "tlpctl balanced &"
           :tooltip "Balanced"
           "")
   (button :class {tlpicon == "󱐋" ? "prfp_button on" : "prfp_button"}
           :onclick "tlpctl performance &"
           :tooltip "Performance"
           "󱐋")))

(defwidget quick_sliders []
  (box :orientation "h"
       :space-evenly false
       :class "quick_sliders"
       :spacing 4
    (box :orientation "v"
         :space-evenly false
      (box :orientation "h"
           :space-evenly false
           :tooltip {volinfo.volume}
           :spacing 4
           :class "quickV_scale"
        (scale :value {volinfo.volume}
               :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
        (label :text {volinfo.icon}))
      (box :orientation "h"
           :space-evenly false
           :tooltip {briginfo.brightness}
           :spacing 4
        (scale :value {briginfo.brightness}
               :onchange "brightnessctl set {}%"
                :min 1)
        (label :text {briginfo.icon})))
      (button :onclick "pwmenu --launcher fuzzel | eww close quick_settings | eww update quick_toggle=false"
                :class "vol_settings"
                :tooltip "Volume Settings"
        "")))

(defwidget notification_history []
  (box :orientation "v"
       :space-evenly false
       :visible notif_visibility
    (scroll :vscroll true
            :hscroll false
            :height 180
            :class "nhtext_box"
      (box :orientation "v"
           :space-evenly false
        (for entry in notif_history
          (box :orientation "v"
               :space-evenly false
               :class "l2 nhis_box"
            (label :text {entry.app})
            (label :text {entry.title})))))
    (button :onclick "killall mako && mako"
      "Clear All")))

(defwindow power_menu
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "0px" :height "0px" :anchor "center")
  :stacking "fg"
  (box :orientation "h"
       :space-evenly false
       :spacing 3
       :class "window_small"
    (button :onclick "reboot"
            :class "quick_button"
            :tooltip "Reboot"
            "")
    (button :onclick "poweroff"
            :class "quick_button"
            :tooltip "Shut-down"
            "")
    (button :onclick "systemctl hibernate && eww close power_menu"
            :class "quick_button"
            :tooltip "Hibernate"
            "")
    (button :onclick "systemctl suspend && eww close power_menu"
            :class "quick_button"
            :tooltip "Sleep"
            "")
    (button :onclick "eww close power_menu"
            :class "quick_button"
            :tooltip "Close"
            "")))

(defwindow music_player
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "210px" :height "110px" :anchor "top left")
  :stacking "fg"
    (box :orientation "v"
         :space-evenly false
         :class "window"
      (music_info)
      (music_buttons)))

(defwidget music_info []
  (box :orientation "h" 
       :space-evenly false
      (progress :orientation "v" :value {cava[0]} :flipped true)
      (progress :orientation "v" :value {cava[1]} :flipped true)
      (progress :orientation "v" :value {cava[2]} :flipped true)
      (progress :orientation "v" :value {cava[3]} :flipped true)
      (progress :orientation "v" :value {cava[4]} :flipped true)
      (progress :orientation "v" :value {cava[5]} :flipped true)
      (progress :orientation "v" :value {cava[6]} :flipped true)
      (progress :orientation "v" :value {cava[7]} :flipped true)
      (progress :orientation "v" :value {cava[8]} :flipped true)
      (progress :orientation "v" :value {cava[9]} :flipped true)
      (label :text "${player_data.text != '' && player_data.text != 'null' ? player_data.text : 'nothing playing'}"
             :class "music_text")
      (button :onclick "eww close music_player && eww update music_toggle=false"
              :valign "start"
              :halign "end"
              :hexpand true
              :tooltip "Close"
      "")))

(defwidget music_buttons []
  (box :orientation "h" 
       :space-evenly false
       :spacing 5
       :halign "center"
    (button :onclick "playerctl shuffle toggle"
            :class "shuffle_button"
            :tooltip "Shuffle"
      "${player_data.shuffle_icon}")
    (button :onclick "playerctl previous"
            :tooltip "Previous"
      "󰒮")
    (button :onclick "playerctl play-pause"
            :tooltip "Play/Pause"
      "${player_data.icon}")
    (button :onclick "playerctl next"
            :tooltip "Next"
      "󰒭")
    (button :onclick "bash -c 'current=$(playerctl loop); if [ \"$current\" = \"None\" ]; then playerctl loop Playlist; elif [ \"$current\" =       \"Playlist\" ]; then playerctl loop Track; else playerctl loop None; fi'"
            :class "repeat_button"
            :tooltip "Repeat"
      "${player_data.repeat_icon}")))

(defwindow localsend
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "300px" :height "220px" :anchor "top center")
  :stacking "fg"
    (box :orientation "v"
         :space-evenly false
         :class "window"
      (box :orientation "h"
           :spac"e-evenly false
           :halign "center"
           :spacing 3
        (button :class {localsend_tabR == "true" ? "lstab on" : "lstab"}
                :onclick "eww update localsend_tabR=true && eww update localsend_tabS=false && /home/zaydaansayed/dotfiles/.config/eww/scripts/localsendr.sh &"
          "Receive")
        (button :class {localsend_tabS == "true" ? "lstab on" : "lstab"}
                :onclick "eww update localsend_tabR=false && eww update localsend_tabS=true && killall localsend-cli"
          "Send"))
      (receive)
      (send)
      (button :onclick "eww close localsend && killall localsend-cli"
              :valign "end"
              :vexpand true
              :tooltip "Close"
        "")))

(defwidget receive []
  (box :orientation "v" 
       :space-evenly false
       :visible localsend_tabR
       :hexpand true
       :vexpand true
       :halign "center"
       :valign "center"
         (label :text " "
                :class "placeholder_txt icon")
         (label :text "You can now receive files"
                :class "placeholder_txt")))

(defwidget send []
  (box :orientation "h" 
       :space-evenly false
       :visible localsend_tabS
         (button :onclick "zenity --multiple --file-selection &")))

(defwindow system_notification
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "250px" :height "100px" :anchor "center")
  :stacking "fg"
  :focusable true
  (box :orientation "v"
       :space-evenly false
       :class "window"
    (label :text sysnotif_text_main
           :valign "center"
           :vexpand true)
    (box :orientation "h"
         :space-evenly false
         :visible {sysnotif_type == "input"}
      (input :value {sysnotif_input_val == "{}" ? "" : sysnotif_input_val}
             :onchange sysnotif_commandi-c
             :onaccept sysnotif_commandi-a
             :class "sysnotif_input")
      (button :onclick sysnotif_commandi-a
              :class "sysnotif_iconfirm"
        ""))
    (box :orientation "h"
         :space-evenly false
         :visible {sysnotif_type == "information"}
         :valign "end"
         :vexpand true
      (button :onclick sysnotif_commandl
              :class "sysnotif_but"
        sysnotif_text_butl)
      (button :onclick sysnotif_commandr
              :class "sysnotif_but"
              :halign "end"
              :hexpand true
        sysnotif_text_butr))))

(defwindow dock
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "0px" :height "3px" :anchor "bottom center")
  :stacking "fg"
  (eventbox :onhover "eww update dock_visibility=true"
            :onhoverlost "eww update dock_visibility=false" 
    (revealer :transition "slideup"
              :reveal dock_visibility
      (box :class "window dock"
           :orientation "h"
           :space-evenly false
           :spacing {arraylength(active_apps) > 0 ? "10" : "5"}
        (button :onclick "fuzzel &"
                :class "fuzzel_button"
                :tooltip "fuzzel"
                    (image :path "/home/zaydaansayed/dotfiles/.config/eww/scripts/hyprland_logo.png"
                   :image-width 50
                   :image-height 50))
        (apps)
        (button :onclick {tray_toggle ? "eww update tray_toggle=false" : "eww update tray_toggle=true"}
                :class "tray_button"
                :tooltip "System tray"
          (box :orientation "h"
               :space-evenly false
               :spacing 5
            (label :text {tray_toggle ? "" : ""})
            (systray :visible tray_toggle
                     :class "systemtray")))))))

(defwidget apps []
  (box :orientation "h"
       :space-evenly false
    (for app in active_apps
          (box :orientation "h"
               :space-evenly false
            (button :onclick `hyprctl dispatch 'hl.dsp.focus({ window = "pid:${app.pid}" })'`
                    :class {app.focused ? "dock_button on" : "dock_button"}
                    :tooltip {app.title}
            (image :icon {app.icon}
                   :icon-size "dialog"))))))

(defwindow ai
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "300px" :height "500px" :anchor "top right")
  :stacking "fg"
  :focusable true
  (box :orientation "v"
       :space-evenly false
       :class "window"
    (ai_placeholder)
    (ai_chat)
    (ai_bottom)
    (box :orientation "h"
         :space-evenly false
         :spacing 3
      (button :onclick "eww open ai_menu"
              :class "ai_menu_button"
              :tooltip "Open Menu"
        "")
    (button :onclick "eww close ai && eww update ai_toggle=false && eww update ai_file_paths='[]' && killall ollama"
            :class "ai_close"
            :tooltip "Close"
      ""))))

(defwidget ai_placeholder []
  (box :orientation "v"
       :space-evenly false
       :class "ai_main"
       :visible {arraylength(ai_txt) < 1}
    (box :orientation "v"
         :space-evenly false
         :valign "center"
         :vexpand true
      (label :text "󰚩"
             :class "placeholder_txt ai icon")
      (label :text "Isaac is Ready!"
             :class "placeholder_txt message"))))

(defwidget ai_chat []
  (scroll :vscroll true
          :class "ai_main"
          :visible {arraylength(ai_txt) > 0}
    (box :orientation "v"
         :space-evenly false
      (for ai in ai_txt
        (box :orientation "v"
             :space-evenly false
          (for att in {ai.attachments ?: []}
            (box :orientation "v"
                 :space-evenly false
              (box :class "ai_image prompt"
                   :visible {att != "" && matches(att ?: "", "(?i)\\.(png|jpg|jpeg|webp)$")}
                   :style "background-image: url('${att}');"
                   :halign "end")
                (box :orientation "v"
                     :space-evenly false
                     :class "l2 ai_txt attachment"
                     :visible {att != "" && !matches(att, "(?i)\\.(png|jpg|jpeg|webp)$")}
                  (label :text "󰈙" :class "ai_txt document")
                  (label :text att))))
          (label :show-truncated false
                 :wrap true
                 :text {ai.prompt}
                 :halign "end"
                 :valign "start"
                 :class "l2 ai_txt prompt")
          (for block in {ai.response}
            (box :orientation "v"
                 :space-evenly false
              (label :show-truncated false
                     :wrap true
                     :text {block.content}
                     :halign "start"
                     :valign "start"
                     :class "l2 ai_txt"
                     :visible {block.type == "text"})
              (box :orientation "v"
                   :space-evenly false
                   :class "l2 ai_txt"
                   :visible {block.type == "code"}
                (box :orientation "h"
                     :space-evenly false
                  (label :text "Code" 
                         :halign "start" 
                         :hexpand true)
                  (button :onclick "echo '${block.content}' | wl-copy"
                          :class "ai_code_copy"
                          :tooltip "Copy Code"
                    "󰆏 Copy"))
                (input :value {block.content}
                       :class "ai_code_input")))))))))
(defwidget ai_bottom []
  (box :orientation "v"
       :space-evenly false
    (label :text "Loading..."
           :class "placeholder_txt ai_loading"
           :visible ai_loading)
    (scroll :hscroll false
            :vscroll true
            :visible {arraylength(ai_file_paths) > 0}
            :class "l2 ai_iattached"
      (box :orientation "v"
           :space-evenly false
        (box :orientation "v"
             :space-evenly false
             :halign "center"
             :spacing 4
             :class "ai_att_top"
          (label :text "${arraylength(ai_file_paths)} File(s) Attached")
          (button :onclick "eww update ai_file_paths='[]'"
                  :tooltip "Clear All Attachments"
            "Clear"))
        (for path in ai_file_paths
          (box :orientation "v"
               :space-evenly false
               :spacing 5
               :class "ai_ifiles"
            (box :class "ai_image input"
                 :visible {path != "" && matches(path ?: "", "(?i)\\.(png|jpg|jpeg|webp)$")}
                 :style "background-image: url('${path}');")
            (label :text path 
                   :show-truncated true
                   :visible {path != "" && !matches(path, "(?i)\\.(png|jpg|jpeg|webp)$")})))))
    (box :orientation "h"
         :space-evenly false
(input :value ai_dinput
             :onchange "eww update ai_prompt=\"$(cat << 'EOF_SAFE'
{}
EOF_SAFE
)\""
             :onaccept {strlength(ai_prompt) > 0 ? "/home/zaydaansayed/dotfiles/.config/eww/scripts/ai.sh &" : ""}
             :class {strlength(ai_prompt) > 0 ? "ai_input" : "ai_input empty"})
      (button :onclick "/home/zaydaansayed/dotfiles/.config/eww/scripts/ai.sh &"
              :visible {strlength(ai_prompt) > 0}
              :class "ai_ibutton send"
              :tooltip "Send"
        "")
      (button :class "ai_ibutton"
              :onclick "/home/zaydaansayed/dotfiles/.config/eww/scripts/file_picker.sh &"
              :tooltip "Attach file"
        "󰁦"))))

(defwindow ai_menu
  :monitor 0
  :geometry (geometry :x "106px" :y "3px" :width "200px" :height "510px" :anchor "top right")
  :stacking "overlay"
  :focusable true
  (box :orientation "v"
       :space-evenly false
       :class "window"
       :spacing 3
    (button :onclick "eww update ai_chat_id='' && eww close ai_menu"
            :class "ai_new_chat"
            :tooltip "Create New Chat"
            "+ New Chat")
    (scroll :vscroll true
            :hscroll false
            :vexpand true
            :class "ai_menu_scroll"
      (box :orientation "v"
           :space-evenly false
           :spacing 3
        (for chat in ai_menu_chats
  (box :orientation "h"
       :space-evenly false
       :spacing 3
    (button :onclick "eww update ai_chat_id='${chat.id}' && eww close ai_menu"
            :tooltip {chat.title}
            :class {ai_chat_id == chat.id ? "ai_chat on" : "ai_chat"}
      (label :text {chat.title}
             :show-truncated true))
    (button :onclick "eww update sysnotif_type='input' && eww update sysnotif_text_main='Rename Chat' && eww update sysnotif_commandi-a='/home/zaydaansayed/dotfiles/.config/eww/scripts/ai_rename_chat.sh ${chat.id} \"{}\" & eww close system_notification' && eww open system_notification"
            :tooltip "Rename Chat"
      "󰏫")
    (button :onclick "rm -f /home/zaydaansayed/Documents/ai_chats/${chat.id}.json && jq 'del(.[] | select(.id == \"${chat.id}\"))' /home/zaydaansayed/Documents/ai_chats/index.json > /home/zaydaansayed/Documents/ai_chats/index.json.tmp && mv /home/zaydaansayed/Documents/ai_chats/index.json.tmp /home/zaydaansayed/Documents/ai_chats/index.json"
            :tooltip "Delete Chat"
      "󰆴")))))
    (button :onclick "eww update sysnotif_type='input' && eww update sysnotif_input_val=\"$(cat /home/zaydaansayed/Documents/ai_dynam_context.txt)\" && eww update sysnotif_text_main='Change AI Context' && eww update sysnotif_commandi-a='echo '{}' > /home/zaydaansayed/Documents/ai_dynam_context.txt && eww close system_notification' && eww open system_notification"
            :tooltip "Change AI Personality"
      "")
    (button :onclick "eww close ai_menu"
            :valign "end"
            :tooltip "Close"
      "")))
