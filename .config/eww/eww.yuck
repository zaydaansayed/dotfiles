(deflisten batterypercentage      :initial ""          `~/.config/eww/scripts/battery.sh`)
(deflisten neticon                :initial ""          `~/.config/eww/scripts/network.sh`)
(deflisten bticon                 :initial ""          `~/.config/eww/scripts/bluetooth.sh`)
(deflisten active_workspace       :initial ""          `~/.config/eww/scripts/workspaces.sh`)
(deflisten spotify_data           :initial '{"text": "", "icon": "", "visible": false}' "~/.config/eww/scripts/player.sh")
(deflisten volume                 :initial ""          `~/.config/eww/scripts/volume.sh`)
(deflisten volicon                :initial ""          `~/.config/eww/scripts/volicon.sh`)
(deflisten brightness             :initial ""          `~/.config/eww/scripts/brightness.sh`)
(deflisten brigicon               :initial ""          `~/.config/eww/scripts/brigicon.sh`)
(deflisten notif_visibility       :initial "false"     `~/dotfiles/.config/eww/scripts/notification_visibility.sh`)
(deflisten notif                  :initial ""          `~/dotfiles/.config/eww/scripts/notification_history.sh`)
(deflisten network_button         :initial "disabled"  `~/.config/eww/scripts/network_button.sh`)
(deflisten bluetooth_button       :initial "disabled"  `~/.config/eww/scripts/bluetooth_button.sh`)
(deflisten bticon_button          :initial ""          `~/.config/eww/scripts/bticon_button.sh`)
(deflisten quick_settings_monitor :initial ""          `~/.config/eww/scripts/quick_settings_monitor.sh`)

(defpoll timenum :interval "30s" `date +"%R"`)
(defpoll tlpicon :interval "200ms" `~/.config/eww/scripts/tlp.sh`)

(defvar notif_app   "")
(defvar notif_title "")
(defvar notif_body  "")
(defvar tlp_toggle  "false")

(defwidget spotify []
  (box :class "spotify" 
       :orientation "h" 
       :space-evenly false
       :spacing 10
       :visible {spotify_data.visible}
    (button :onclick "playerctl --player=spotify play-pause" 
            :class "spotify-btn"
            "${spotify_data.icon}")
    (label :text {spotify_data.text} :class "spotify-text")))

(defwidget workspaces []
  (box :orientation "h"
       :class "workspaces"
    (for i in "[1, 2, 3, 4, 5]"
      (button :onclick "hyprctl dispatch workspace ${i}"
              :class {active_workspace == i ? "ws-btn active" : "ws-btn"}
              (label :text i)))))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "1273px" :height "25px" :anchor "top center")
  :stacking "bg"
  :exclusive true 
  (centerbox :orientation "h"
    (box :space-evenly false (spotify) (workspaces))
    (box :space-evenly false (label :text timenum))
    (box :space-evenly false :halign "end"
         (label  :text bticon  :class "bluetooth")
         (label  :text neticon :class "network")
         (label  :text batterypercentage :class "battery")
         (button :onclick "~/dotfiles/.config/eww/scripts/quick_settings_button.sh"
                 :class {quick_settings_monitor == "open" ? "quick_center open" : "quick_center closed"}

         ""))))

(defwindow screenprint
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "127px" :height "25px" :anchor "top center")
  :stacking "fg"
  :focusable true
  (box :orientation "h"
       (button :onclick "hyprshot -m output -o /home/zaydaansayed/Pictures/Screenshots | eww close screenprint" :class "screenprint-btn output" "󰍹")
       (button :onclick "hyprshot -m window -o /home/zaydaansayed/Pictures/Screenshots | eww close screenprint" :class "screenprint-btn window" "󰖯")
       (button :onclick "hyprshot -m region -o /home/zaydaansayed/Pictures/Screenshots | eww close screenprint" :class "screenprint-btn region" "")
       (button :onclick "eww close screenprint" :class "screenprint-btn close" "")))


(defwindow volume
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "192px" :height "18px" :anchor "top center")
  :stacking "fg"
  (box :orientation "h"
       :space-evenly false
       (progress :orientation "h" 
                 :value volume
                 :class "volbar")
       (label :text volicon)))

(defwindow brightness
  :monitor 0
  :geometry (geometry :x "0px" :y "3px" :width "192px" :height "18px" :anchor "top center")
  :stacking "fg"
  (box :orientation "h"
       :space-evenly false
       (progress :orientation "h" 
                 :value brightness
                 :class "brigbar")
       (label :text brigicon)))

(defwindow notification_popup
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "300px" :height "75px" :anchor "top right")
  :stacking "fg"
  (box :orientation "v"
    (box :orientation "h"
       (label :text notif_app)
       (button :onclick "eww close notification_popup && makoctl dismiss"
               :halign "end"
         (label :text "")))
    (label :text notif_title
           :halign "start")
    (label :text notif_body
           :halign "start")))

(defwindow quick_settings
  :monitor 0
  :geometry (geometry :x "6px" :y "3px" :width "0px" :height "0px" :anchor "top right")
  :stacking "fg"
    (box :orientation "v"
         :space-evenly false
      (quick_controls)
      (tlp_menu)
      (notification_history)))

(defwidget quick_controls []
  (box :orientation "h"
       :space-evenly false
       :class "quick_controls"
   (button :class {network_button == "enabled" ? "quick_button net on" : "quick_button net off"}
           :onclick "nmcli networking | grep -q 'enabled' && nmcli networking off || nmcli networking on"
           neticon)
   (button :class {network_button == "enabled" ? "quick_extend net on" : "quick_extend net off"}
           :onclick "networkmanager_dmenu | eww close quick_settings"
           ">")
   (button :class {bluetooth_button == "enabled" ? "quick_button bt on" : "quick_button bt off"}
           :onclick "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
           bticon_button)
    (button :class {bluetooth_button == "enabled" ? "quick_extend bt on" : "quick_extend bt off"}
            :onclick "bzmenu -l fuzzel | eww close quick_settings"
            ">")
      (button :class {tlp_toggle == "true" ? "quick_button tlp_toggle on" : "quick_button tlp_toggle off"}
              :onclick {tlp_toggle == "true" ? "eww update tlp_toggle=false" : "eww update tlp_toggle=true"}
              tlpicon)))

(defwidget tlp_menu []
  (box :orientation "h"
       :space-evenly false
       :class "tlp_menu"
       :visible tlp_toggle
   (button :class {tlpicon == "" ? "prfp_button power-saver on" : "prfp_button power-saver off"}
           :onclick "tlpctl power-saver"
           :timeout 10000
           "")
   (button :class {tlpicon == "" ? "prfp_button balanced on" : "prfp_button balanced off"}
           :onclick "tlpctl balanced"
           :timeout 10000
           "")
   (button :class {tlpicon == "󱐋" ? "prfp_button performance on" : "prfp_button performance off"}
           :onclick "tlpctl performance"
           :timeout 10000
           "󱐋")))

(defwidget notification_history []
  (box :orientation "v"
       :space-evenly false
       :class "notification-history"
       :visible notif_visibility
    (scroll :vscroll true
            :height 180
            :class "notification-history text"
      (box :orientation "v"
           :space-evenly false
        (label :text "---------------------------")
        (for entry in notif
          (box :orientation "v"
               :space-evenly false  
            (label :text {entry.app})
            (label :text {entry.title})
            (label :text "---------------------------")))))
    (button :onclick "killall mako && mako"
      "Clear All")))
